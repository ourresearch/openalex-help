---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Search from '../components/Search.astro';

interface Props {
  title: string;
  description?: string;
  wide?: boolean; // full-bleed pages (DocsShell) manage their own container
}
const { title, description, wide = false } = Astro.props;

// Help is deliberately first: audience priority is nontechnical > semitechnical > technical.
const tabs = [
  { label: 'Help', href: '/help/' },
  { label: 'Docs', href: '/docs/' },
  { label: 'API', href: '/api/' },
  { label: 'Learn', href: '/learn/' },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | OpenAlex Help Center</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(path, Astro.site)} />
  </head>
  <body>
    <header>
      <nav aria-label="Main">
        <a href="/help/" class="logo">
          <img src="/brand/openalex-lockup.png" alt="OpenAlex" height="22" />
        </a>
        <div class="tabs">
          {tabs.map((t) => (
            <a href={t.href} aria-current={path.startsWith(t.href) ? 'page' : undefined}>{t.label}</a>
          ))}
        </div>
        <div class="nav-center">
          <Search />
        </div>
        <div class="nav-right">
          <a class="site-link" href="https://openalex.org">openalex.org ↗</a>
        </div>
      </nav>
    </header>

    <main class:list={{ wide }}>
      <slot />
    </main>

    <style>
      header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--bg);
        border-bottom: 1px solid var(--line);
      }
      nav {
        position: relative;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        height: var(--nav-h);
        padding: 0 1.5rem;
      }
      .logo {
        display: flex;
        align-items: center;
      }
      .logo img {
        height: 22px;
        width: auto;
        display: block;
      }
      .tabs {
        display: flex;
        align-self: stretch;
      }
      /* Cursor-measured tabs: 14px, 12px side padding, active = accent text +
         a 2px accent underline spanning the full pill, sitting on the header's
         bottom border. */
      .tabs a {
        display: flex;
        align-items: center;
        color: var(--muted);
        font-size: 0.875rem;
        padding: 0 0.75rem;
        border-radius: 4px;
        position: relative;
        transition: color 0.15s;
      }
      .tabs a:hover {
        color: var(--ink);
        text-decoration: none;
      }
      .tabs a[aria-current='page'] {
        color: var(--accent);
      }
      .tabs a[aria-current='page']::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
        height: 2px;
        background: var(--accent);
      }
      /* Search pill dead-center in the header, like Cursor. */
      .nav-center {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
      }
      .nav-right {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .site-link {
        font-size: 0.82rem;
        color: var(--bg);
        background: var(--ink);
        border: 1px solid var(--ink);
        border-radius: 999px;
        padding: 0.32rem 0.85rem;
        font-weight: 500;
        transition: opacity 0.15s;
      }
      .site-link:hover {
        opacity: 0.85;
        color: var(--bg);
        text-decoration: none;
      }
      main {
        flex: 1;
        width: 100%;
        max-width: 84rem;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 5rem;
      }
      main.wide {
        max-width: none;
        margin: 0;
        padding: 0;
      }
      @media (max-width: 1000px) {
        .nav-center {
          position: static;
          transform: none;
          margin-left: auto;
        }
        .nav-right {
          margin-left: 0;
        }
      }
      @media (max-width: 640px) {
        nav {
          gap: 1rem;
        }
        .site-link {
          display: none;
        }
      }
    </style>
  </body>
</html>
