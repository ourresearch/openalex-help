---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Search from '../components/Search.astro';

interface Props {
  title: string;
  description?: string;
  wide?: boolean; // full-bleed pages (DocsShell) manage their own container
}
const { title, description, wide = false } = Astro.props;

// Help is deliberately first (default tab). Order = the two-sided model
// (oxjob #354 Pass R): Help + Recipes = "get things done"; Docs/Entities/API =
// "look things up" (one reference work split across three tabs).
const tabs = [
  { label: 'FAQ', href: '/help/' },
  { label: 'Docs', href: '/docs/' },
  { label: 'Entities', href: '/entities/' },
  { label: 'API', href: '/api/' },
  { label: 'Recipes', href: '/recipes/' },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | OpenAlex Help Center</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(path, Astro.site)} />
  </head>
  <body>
    <header>
      <nav aria-label="Main">
        <a href="/help/" class="logo">
          <img src="/brand/openalex-lockup.png" alt="OpenAlex" height="22" />
          <span class="logo-help">Help</span>
        </a>
        <div class="tabs">
          {tabs.map((t) => (
            <a href={t.href} aria-current={path.startsWith(t.href) ? 'page' : undefined}>{t.label}</a>
          ))}
        </div>
        <div class="nav-center">
          <Search />
        </div>
        <div class="nav-right">
          <a class="site-link" href="https://openalex.org">Main site ↗</a>
          <button class="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        </div>
      </nav>
      <div id="mobile-menu" hidden>
        {tabs.map((t) => (
          <a href={t.href} aria-current={path.startsWith(t.href) ? 'page' : undefined}>{t.label}</a>
        ))}
        <a class="menu-site-link" href="https://openalex.org">Main site ↗</a>
      </div>
    </header>

    <main class:list={{ wide }}>
      <slot />
    </main>

    <script>
      // Heading anchor links (oxjob #354 Pass S): every article section heading
      // is a linkable anchor — hovering shows a link icon (a link, not Cursor's
      // copy icon — deliberate), and clicking the heading or the icon loads the
      // anchor URL.
      const ICON =
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>';
      for (const h of document.querySelectorAll<HTMLHeadingElement>(
        '.prose h2[id], .prose h3[id], .prose h4[id]'
      )) {
        const a = document.createElement('a');
        a.className = 'h-anchor';
        a.href = '#' + h.id;
        a.setAttribute('aria-label', 'Link to this section');
        a.innerHTML = ICON;
        h.appendChild(a);
        h.classList.add('has-anchor');
        h.addEventListener('click', (e) => {
          if ((e.target as Element).closest('a')) return; // real links keep working
          location.hash = h.id;
        });
      }

      // Mobile menu toggle.
      const menuBtn = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const menu = document.getElementById('mobile-menu');
      if (menuBtn && menu) {
        menuBtn.addEventListener('click', () => {
          const open = menu.classList.toggle('open');
          menu.hidden = false; // visibility is driven by the .open class + media query
          menuBtn.setAttribute('aria-expanded', String(open));
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menu.classList.contains('open')) {
            menu.classList.remove('open');
            menuBtn.setAttribute('aria-expanded', 'false');
          }
        });
      }
    </script>

    <style>
      header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--bg);
        border-bottom: 1px solid var(--line);
      }
      nav {
        position: relative;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        height: var(--nav-h);
        padding: 0 1.5rem;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 0.42rem;
      }
      .logo img {
        height: 22px;
        width: auto;
        display: block;
      }
      /* "Help" extends the wordmark: Inter at the wordmark's optical size and
         tracking, light weight so it reads as a suffix, not a second logo. */
      .logo-help {
        font-size: 21px;
        font-weight: 350;
        letter-spacing: -0.02em;
        color: var(--ink);
        line-height: 1;
        transform: translateY(-1px); /* optical baseline match with the lockup */
      }
      .logo:hover {
        text-decoration: none;
      }
      .tabs {
        display: flex;
        align-self: stretch;
      }
      /* Cursor-measured tabs: 14px, 12px side padding, active = accent text +
         a 2px accent underline spanning the full pill, sitting on the header's
         bottom border. */
      .tabs a {
        display: flex;
        align-items: center;
        color: var(--muted);
        font-size: 0.875rem;
        padding: 0 0.75rem;
        border-radius: 4px;
        position: relative;
        transition: color 0.15s;
      }
      .tabs a:hover {
        color: var(--ink);
        text-decoration: none;
      }
      .tabs a[aria-current='page'] {
        color: var(--accent);
      }
      .tabs a[aria-current='page']::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
        height: 2px;
        background: var(--accent);
      }
      /* Search pill dead-center in the header, like Cursor. */
      .nav-center {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
      }
      .nav-right {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .site-link {
        font-size: 0.82rem;
        color: var(--bg);
        background: var(--ink);
        border: 1px solid var(--ink);
        border-radius: 999px;
        padding: 0.32rem 0.85rem;
        font-weight: 500;
        transition: opacity 0.15s;
      }
      .site-link:hover {
        opacity: 0.85;
        color: var(--bg);
        text-decoration: none;
      }
      .menu-toggle {
        display: none;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        color: var(--ink);
        background: none;
        border: 1px solid var(--line);
        border-radius: 8px;
        cursor: pointer;
      }
      #mobile-menu {
        display: none;
        flex-direction: column;
        padding: 0.5rem 1.5rem 1rem;
        border-top: 1px solid var(--line);
        background: var(--bg);
      }
      #mobile-menu a {
        padding: 0.65rem 0.25rem;
        font-size: 0.95rem;
        color: var(--muted);
        border-bottom: 1px solid var(--line);
      }
      #mobile-menu a:hover {
        color: var(--ink);
        text-decoration: none;
      }
      #mobile-menu a[aria-current='page'] {
        color: var(--accent);
      }
      #mobile-menu .menu-site-link {
        color: var(--ink);
        font-weight: 500;
        border-bottom: none;
      }
      main {
        flex: 1;
        width: 100%;
        max-width: 84rem;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 5rem;
      }
      main.wide {
        max-width: none;
        margin: 0;
        padding: 0;
      }
      /* The dead-centered search pill needs vw/2 - 160px to clear the
         logo + tabs block (~560px) — true only from ~1440px up. Below that
         the pill is in normal flow on the right (it used to break at
         1000–1400px: the centered pill painted over the API/Recipes tabs). */
      @media (max-width: 1439px) {
        .nav-center {
          position: static;
          transform: none;
          margin-left: auto;
        }
        .nav-right {
          margin-left: 0;
        }
      }
      /* Mobile (Cursor pattern): tabs collapse into a hamburger; the main-site
         button moves into the menu. */
      @media (max-width: 900px) {
        nav {
          gap: 1rem;
        }
        .tabs,
        .site-link {
          display: none;
        }
        .menu-toggle {
          display: flex;
        }
        #mobile-menu.open {
          display: flex;
        }
      }
    </style>
  </body>
</html>
