---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Search from '../components/Search.astro';
import RailNav from '../components/RailNav.astro';
import Icon from '../components/Icon.astro';
import { PRIMARY_TABS, ROLE_LABELS, CHAT_ROWS, APP_LINK, isPrimaryActive } from '../lib/nav-primary';

interface Props {
  title: string;
  description?: string;
  wide?: boolean; // full-bleed pages (DocsShell) manage their own container
}
const { title, description, wide = false } = Astro.props;

const path = Astro.url.pathname;
// Two-layer nav drawer (oxjob #750 Pass AM, replacing the Pass AL two-level tab
// bar): the primary nav is a LEFT drawer/rail (RailNav). On Home it's a full
// drawer; inside a tab `html.in-tab` collapses it to an icon rail and the tab's
// sections render in the secondary Sidebar. "In a tab" = the path sits under a
// content tab (Quick Start lives under /tutorials/, so it collapses too).
const TAB_PREFIXES = ['/how-to/', '/tutorials/', '/access/', '/data/', '/api/'];
const inTab = TAB_PREFIXES.some((p) => path.startsWith(p));
// Inside a tab the lockup extends to "OpenAlex Help › <Tab>" (Pass AO —
// replaces the Pass AN title heading inside the secondary drawer, which should
// hold only navigation content).
const activeTab = PRIMARY_TABS.find(
  (t) => t.href !== '/' && path.startsWith(t.href) && t.href !== '/quickstart/'
);
// The homepage has its own hero search box, so hide the top-bar one there — two
// search boxes on one page reads as "these must do different things" (Pass V).
const isHome = path === '/';

// Mobile menu (< 900px, where the rail hides): the same primary items, grouped.
const top = PRIMARY_TABS.filter((t) => t.group === 'top');
const learn = PRIMARY_TABS.filter((t) => t.group === 'learn');
const reference = PRIMARY_TABS.filter((t) => t.group === 'reference');
---

<!doctype html>
<html lang="en" class:list={{ 'in-tab': inTab }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <title>{title ? `${title} | OpenAlex Help Center` : 'OpenAlex Help Center'}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(path, Astro.site)} />
  </head>
  <body>
    <header>
      <div class="topbar">
        <a href="/" class="logo">
          <img src="/brand/openalex-lockup.png" alt="OpenAlex" height="22" />
          <span class="logo-help">Help</span>
        </a>
        {/* "OpenAlex Help › <Tab>" (Pass AO): the current tab extends the
            lockup — the secondary drawer holds only navigation now. */}
        {activeTab && (
          <span class="logo-tab">
            <svg class="logo-tab-sep" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
            <a href={activeTab.href}>{activeTab.label}</a>
          </span>
        )}
        <div class="nav-right">
          <Search button={!isHome} />
          <button class="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        </div>
      </div>
      <div id="mobile-menu" hidden>
        {top.map((t) => (
          <a href={t.href} aria-current={isPrimaryActive(t.href, path) ? 'page' : undefined}>{t.label}</a>
        ))}
        <span class="menu-role">{ROLE_LABELS.learn}</span>
        {learn.map((t) => (
          <a href={t.href} aria-current={isPrimaryActive(t.href, path) ? 'page' : undefined}>{t.label}</a>
        ))}
        <span class="menu-role">{ROLE_LABELS.reference}</span>
        {reference.map((t) => (
          <a href={t.href} aria-current={isPrimaryActive(t.href, path) ? 'page' : undefined}>{t.label}</a>
        ))}
        <span class="menu-role">Chat</span>
        {CHAT_ROWS.map((r) => (
          <a href={r.href} target="_blank" rel="noopener">{r.title} <Icon name="open-in-new" size={12} /></a>
        ))}
        <a class="menu-site-link" href={APP_LINK.href} target="_blank" rel="noopener">{APP_LINK.label} <Icon name="open-in-new" size={12} /></a>
      </div>
    </header>

    <div class="layout">
      <RailNav />
      <main class:list={{ wide }}>
        <slot />
      </main>
    </div>

    <script>
      // Heading anchor links (oxjob #354 Pass S): every article section heading
      // is a linkable anchor — hovering shows a link icon (a link, not Cursor's
      // copy icon — deliberate), and clicking the heading or the icon loads the
      // anchor URL.
      const ICON =
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>';
      for (const h of document.querySelectorAll<HTMLHeadingElement>(
        '.prose h2[id], .prose h3[id], .prose h4[id]'
      )) {
        const a = document.createElement('a');
        a.className = 'h-anchor';
        a.href = '#' + h.id;
        a.setAttribute('aria-label', 'Link to this section');
        a.innerHTML = ICON;
        h.appendChild(a);
        h.classList.add('has-anchor');
        h.addEventListener('click', (e) => {
          if ((e.target as Element).closest('a')) return; // real links keep working
          location.hash = h.id;
        });
      }

      // Mobile menu toggle.
      const menuBtn = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const menu = document.getElementById('mobile-menu');
      if (menuBtn && menu) {
        menuBtn.addEventListener('click', () => {
          const open = menu.classList.toggle('open');
          menu.hidden = false; // visibility is driven by the .open class + media query
          menuBtn.setAttribute('aria-expanded', String(open));
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menu.classList.contains('open')) {
            menu.classList.remove('open');
            menuBtn.setAttribute('aria-expanded', 'false');
          }
        });
      }
    </script>

    <style>
      header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--bg);
        border-bottom: 1px solid var(--line);
      }
      .topbar {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        height: var(--navrow-h);
        padding: 0 1.25rem;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 0.42rem;
      }
      .logo img {
        height: 22px;
        width: auto;
        display: block;
      }
      /* "Help" extends the wordmark: Inter at the wordmark's optical size and
         tracking, normal weight so it reads as a quieter suffix. */
      .logo-help {
        font-size: 21px;
        font-weight: 400;
        letter-spacing: -0.02em;
        color: var(--ink);
        line-height: 1;
        transform: translateY(-1px); /* optical baseline match with the lockup */
      }
      .logo:hover {
        text-decoration: none;
      }
      /* The current tab extends the lockup: same optical size as the "Help"
         suffix, faint chevron separator. */
      .logo-tab {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        line-height: 1;
      }
      .logo-tab-sep {
        flex: none;
        color: var(--faint);
      }
      .logo-tab a {
        display: inline-block; /* transform needs a box */
        font-size: 21px;
        font-weight: 400;
        letter-spacing: -0.02em;
        color: var(--ink);
        transform: translateY(-1px); /* match .logo-help's optical baseline */
      }
      .logo-tab a:hover {
        color: var(--accent);
        text-decoration: none;
      }
      .nav-right {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .menu-toggle {
        display: none;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        color: var(--ink);
        background: none;
        border: 1px solid var(--line);
        border-radius: 8px;
        cursor: pointer;
      }
      #mobile-menu {
        display: none;
        flex-direction: column;
        padding: 0.5rem 1.5rem 1rem;
        border-top: 1px solid var(--line);
        background: var(--bg);
      }
      #mobile-menu a {
        padding: 0.65rem 0.25rem;
        font-size: 0.95rem;
        color: var(--muted);
        border-bottom: 1px solid var(--line);
      }
      #mobile-menu a:hover {
        color: var(--ink);
        text-decoration: none;
      }
      #mobile-menu .menu-role {
        padding: 0.75rem 0.25rem 0.1rem;
        font-size: 0.66rem;
        font-weight: 650;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--faint);
      }
      #mobile-menu a[aria-current='page'] {
        color: var(--ink);
        font-weight: 500;
      }
      #mobile-menu .menu-site-link {
        color: var(--ink);
        font-weight: 500;
        border-bottom: none;
      }

      /* Two-column shell: primary rail/drawer + the page. --primary-w tracks
         the rail's reserved width (drawer on Home, icon rail in a tab — set in
         global.css); the rail's hover-flyout overflows this column as an
         overlay, so the reserved space never jumps. */
      .layout {
        display: grid;
        grid-template-columns: var(--primary-w) minmax(0, 1fr);
        align-items: start;
      }
      main {
        width: 100%;
        max-width: 84rem;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 5rem;
      }
      main.wide {
        max-width: none;
        margin: 0;
        padding: 0;
      }

      /* Mobile: the rail hides (RailNav's own media query) and the layout
         collapses to one column; the top-bar hamburger drives the menu. */
      @media (max-width: 900px) {
        .layout {
          grid-template-columns: 1fr;
        }
        .menu-toggle {
          display: flex;
        }
        #mobile-menu.open {
          display: flex;
        }
      }
    </style>
  </body>
</html>
