---
// Full-bleed app shell for the reference/learn tabs (landings AND articles):
// the SECONDARY nav drawer (Sidebar — the active tab's sections/pages) pinned
// to the left, content+rail block centered in the rest. This whole block lives
// in <main>, i.e. to the RIGHT of the primary rail (oxjob #750 Pass AM): on a
// tab page the primary drawer is collapsed to an icon rail in Base.astro, and
// this secondary drawer is the second layer.
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
import type { ResolvedGroup } from '../lib/nav';
import type { Tab } from '../lib/tabs';

interface Props {
  title: string;
  description?: string;
  tab: Tab;
  groups: ResolvedGroup[];
  activeSlug?: string;
}
const { title, description, tab, groups, activeSlug } = Astro.props;
---

<Base title={title} description={description} wide>
  <div class="shell">
    <Sidebar tab={tab} groups={groups} activeSlug={activeSlug} />
    <div class="content">
      <div class="columns">
        <div class="main-col"><slot /></div>
        <div class="rail-col"><slot name="rail" /></div>
      </div>
    </div>
  </div>
</Base>

<style>
  .shell {
    display: grid;
    /* Secondary drawer keeps its own width (--sidebar-w) — the primary drawer
       narrowed in Pass AN, but page titles here need the room. */
    grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
    min-height: calc(100dvh - var(--nav-h));
  }
  .content {
    /* Top padding matches the Sidebar's 1.5rem (Pass AV): the breadcrumb row,
       the sidebar's first item, and the rail's "On this page" label sit on
       the same line. Change any of the three together. */
    padding: 1.5rem 2rem 5rem;
    min-width: 0;
  }
  .columns {
    display: grid;
    grid-template-columns: minmax(0, 46rem) 13rem;
    gap: 3.5rem;
    justify-content: center;
  }
  .rail-col {
    font-size: 0.84rem;
  }
  @media (max-width: 1180px) {
    .columns {
      grid-template-columns: minmax(0, 46rem);
    }
    .rail-col {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .shell {
      grid-template-columns: 1fr;
    }
    .content {
      padding: 2rem 1.25rem 4rem;
    }
  }
</style>
