---
// Full-bleed app shell for the Docs and API tabs (landings AND articles):
// sidebar pinned to the viewport's left edge, content+rail block centered in
// the remaining space — the Cursor docs layout.
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
import type { ResolvedGroup } from '../lib/nav';
import type { Tab } from '../lib/tabs';

interface Props {
  title: string;
  description?: string;
  tab: Tab;
  groups: ResolvedGroup[];
  activeSlug?: string;
}
const { title, description, tab, groups, activeSlug } = Astro.props;
---

<Base title={title} description={description} wide>
  <div class="shell">
    <Sidebar tab={tab} groups={groups} activeSlug={activeSlug} />
    <div class="content">
      <div class="columns">
        <div class="main-col"><slot /></div>
        <div class="rail-col"><slot name="rail" /></div>
      </div>
    </div>
  </div>
</Base>

<style>
  .shell {
    display: grid;
    grid-template-columns: 16.5rem minmax(0, 1fr);
    min-height: calc(100dvh - var(--nav-h));
  }
  .content {
    padding: 2.5rem 2rem 5rem;
    min-width: 0;
  }
  .columns {
    display: grid;
    grid-template-columns: minmax(0, 46rem) 13rem;
    gap: 3.5rem;
    justify-content: center;
  }
  .rail-col {
    font-size: 0.84rem;
  }
  @media (max-width: 1180px) {
    .columns {
      grid-template-columns: minmax(0, 46rem);
    }
    .rail-col {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .shell {
      grid-template-columns: 1fr;
    }
    .content {
      padding: 2rem 1.25rem 4rem;
    }
  }
</style>
