---
// Help Center homepage (oxjob #354 Pass U/V): the front door for the whole
// site. We don't know what mode a visitor arrives in — asking a question,
// reading reference, following a tutorial — so the homepage orients: a one-line
// description, one search box, then a flat grid of cards for everywhere you can
// go. No section headers, no second search box (Pass V, Jason 2026-08-06).
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';

// "Ask AI" deep links: providers with working URL-prefill. The prompt tells
// the assistant to ground itself in this site; the user appends their question.
const prompt =
  'Answer my question using the OpenAlex documentation at https://help.openalex.org/ (machine index: https://help.openalex.org/llms.txt). My question: ';
const providers = [
  { label: 'Claude', href: `https://claude.ai/new?q=${encodeURIComponent(prompt)}` },
  { label: 'ChatGPT', href: `https://chatgpt.com/?q=${encodeURIComponent(prompt)}` },
  { label: 'Perplexity', href: `https://www.perplexity.ai/search?q=${encodeURIComponent(prompt)}` },
];

// One card per destination — the five tabs plus the three support surfaces, all
// the same design (Ask AI, below, is the eighth; it expands instead of links).
const cards = [
  { title: 'FAQ', href: '/help/', icon: 'help-circle', blurb: 'Real questions answered plainly' },
  { title: 'Docs', href: '/docs/', icon: 'notebook', blurb: 'How OpenAlex works and how to use it' },
  {
    title: 'Entities',
    href: '/entities/',
    icon: 'shapes',
    blurb: "Works, authors, etc: how they're made and what each field means",
  },
  { title: 'API', href: '/api/', icon: 'cog', blurb: 'Endpoints, filters, auth, rate-limits, etc.' },
  { title: 'Recipes', href: '/recipes/', icon: 'food', blurb: 'Step-by-step tutorials' },
  {
    title: 'Community Forum',
    href: 'https://groups.google.com/g/openalex-users',
    icon: 'message',
    blurb: 'Discuss with other users',
  },
  {
    title: 'Contact Support',
    href: 'https://openalex.org/contact',
    icon: 'mail',
    blurb: 'Get help from our team',
  },
];
---

<Base title="" description="Help, documentation, API reference, and tutorials for OpenAlex, the open catalog of the global research system.">
  <div class="wrap home">
    <section class="hero reveal">
      <h1>OpenAlex Help Center</h1>
      <p class="subtitle">
        OpenAlex is an open catalog of the global research system — papers, authors, institutions,
        journals, and topics, all connected. This help center is where you learn to use it.
      </p>
      <button class="big-search" data-search-trigger aria-label="Search the help center">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
        </svg>
        <span class="placeholder">Search the help center</span>
        <kbd>⌘K</kbd>
      </button>
    </section>

    <section class="explore reveal" style="animation-delay: 0.08s">
      <div class="card-grid">
        {cards.map((c) => (
          <Card title={c.title} href={c.href}>
            <Icon name={c.icon} slot="icon" />
            {c.blurb}
          </Card>
        ))}
        <details class="ai-card ask-ai">
          <summary>
            <span class="ai-head">
              <Icon name="sparkles" />
              <span class="ai-title">Ask AI</span>
            </span>
            <span class="ai-body">Open your assistant, primed with our docs</span>
          </summary>
          <div class="providers">
            {providers.map((p) => (
              <a href={p.href} target="_blank" rel="noopener">{p.label} ↗</a>
            ))}
          </div>
        </details>
      </div>
    </section>
  </div>
</Base>

<style>
  .wrap.home {
    max-width: 46rem;
    margin: 0 auto;
    padding-top: 2.5rem;
  }
  .hero {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .hero h1 {
    margin: 0 0 0.75rem;
  }
  .subtitle {
    max-width: 38rem;
    margin: 0 auto 2rem;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.6;
  }
  .big-search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 40rem;
    margin: 0 auto;
    height: 3.4rem;
    padding: 0 1rem;
    font: inherit;
    font-size: 0.95rem;
    color: var(--faint);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
    cursor: text;
    transition: border-color 0.15s;
  }
  .big-search:hover {
    border-color: var(--line-strong);
  }
  .placeholder {
    flex: 1;
    text-align: left;
  }
  .big-search kbd {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--faint);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
    background: var(--bg);
  }

  /* The eight-card grid — five tabs + three support surfaces, all one design. */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.9rem;
    /* .reveal makes the section a stacking context; lift it so the Ask AI
       dropdown can't be covered by anything painted later. */
    position: relative;
    z-index: 10;
  }

  /* Ask AI: matches Card.astro exactly, but it's a <details> that expands to a
     provider menu instead of an <a> that navigates. */
  .ai-card {
    display: flex;
    flex-direction: column;
    color: inherit;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 5px;
    position: relative;
    transition: border-color 0.15s;
  }
  .ai-card:hover {
    border-color: var(--line-strong);
  }
  .ai-card:hover .ai-title {
    color: var(--accent);
  }
  .ai-card summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }
  .ai-card summary::-webkit-details-marker {
    display: none;
  }
  .ai-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--line);
    background: var(--panel-strong);
  }
  .ai-head :global(svg) {
    flex-shrink: 0;
    color: var(--muted);
  }
  .ai-title {
    font-size: 0.92rem;
    font-weight: 600;
  }
  .ai-body {
    padding: 0.7rem 1rem 0.9rem;
    color: var(--muted);
    font-size: 0.87rem;
    line-height: 1.5;
  }
  .providers {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 0.4rem);
    z-index: 5;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.12);
    padding: 0.35rem;
  }
  .providers a {
    display: block;
    padding: 0.45rem 0.75rem;
    border-radius: 7px;
    color: var(--ink);
    font-size: 0.9rem;
    text-align: left;
  }
  .providers a:hover {
    background: var(--panel);
    text-decoration: none;
    color: var(--accent);
  }
</style>

<script>
  // Close the Ask AI menu when clicking elsewhere.
  const askAi = document.querySelector<HTMLDetailsElement>('.ask-ai');
  if (askAi) {
    document.addEventListener('click', (e) => {
      if (askAi.open && !askAi.contains(e.target as Node)) askAi.open = false;
    });
  }
</script>
