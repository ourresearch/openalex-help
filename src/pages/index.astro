---
// Help Center homepage (oxjob #354 Pass U/V/X; body reshaped oxjob #750 Pass
// AM): the front door for the whole site — a big left-justified masthead, one
// full-width search box, then three short intro paragraphs (Learn / Reference /
// Chat) mirroring the site's two-sided model. The card grid that used to live
// here moved into the left nav drawer (RailNav), so the body is now just an
// orientation blurb; the drawer is the map.
import Base from '../layouts/Base.astro';
import { CHAT_ROWS } from '../lib/nav-primary';

const forum = CHAT_ROWS.find((r) => r.title === 'Community Forum')!;
const report = CHAT_ROWS.find((r) => r.title === 'Report an Issue')!;
const youtube = CHAT_ROWS.find((r) => r.title === 'YouTube')!;
---

<Base title="" description="Help, documentation, API reference, and tutorials for OpenAlex, the open catalog of the global research system.">
  <div class="wrap home">
    <section class="hero reveal">
      <h1>OpenAlex Help Center</h1>
      <p class="subtitle">
        Get help with <a href="https://openalex.org">OpenAlex</a>, a comprehensive index of the
        world's research.
      </p>
      <button class="big-search" data-search-trigger aria-label="Search the help center">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
        </svg>
        <span class="placeholder">Search the help center</span>
        <kbd data-kbd-shortcut>⌘K</kbd>
      </button>
    </section>

    <section class="intro reveal" style="animation-delay: 0.08s">
      <p>
        <strong>Learn.</strong> New to OpenAlex, or working toward a specific goal?
        The <a href="/how-to/">How-to guides</a> answer common questions task by task,
        and the <a href="/tutorials/">Tutorials</a> walk through longer projects end to
        end. If you have five minutes, start with the <a href="/tutorials/quickstart/">Quick Start</a>.
      </p>
      <p>
        <strong>Reference.</strong> Already know what you're looking
        for? <a href="/access/">Access</a> covers getting the data, pricing, and
        fixing errors; <a href="/data/">Data</a> explains what each entity means and how it's
        built; and the <a href="/api/">API</a> reference documents the endpoints, filters,
        and authentication.
      </p>
      <p>
        <strong>Chat.</strong> Prefer to talk it through? Ask other users in
        the <a href={forum.href} target="_blank" rel="noopener">Community Forum</a>, <a href={report.href} target="_blank" rel="noopener">report a bug or data error</a>,
        or watch tutorials and town halls on <a href={youtube.href} target="_blank" rel="noopener">YouTube</a>. You can also prime
        your favorite AI assistant with our docs using the <strong>Ask AI</strong> links in the sidebar.
      </p>
    </section>
  </div>
</Base>

<style>
  .wrap.home {
    max-width: 46rem;
    margin: 0 auto;
    padding-top: 2.5rem;
  }
  /* Masthead: big, bold, left-justified (Jason 2026-08-07, screenshot spec). */
  .hero {
    text-align: left;
    margin-bottom: 2.5rem;
  }
  .hero h1 {
    margin: 0 0 0.85rem;
    font-size: 3.5rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .subtitle {
    max-width: 38rem;
    margin: 0 0 2rem;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.6;
  }
  .big-search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    height: 3.4rem;
    padding: 0 1rem;
    font: inherit;
    font-size: 0.95rem;
    color: var(--faint);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
    cursor: text;
    transition: border-color 0.15s;
  }
  .big-search:hover {
    border-color: var(--line-strong);
  }
  .placeholder {
    flex: 1;
    text-align: left;
  }
  .big-search kbd {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--faint);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
    background: var(--bg);
  }

  /* Three short orientation paragraphs (Learn / Reference / Chat), oxjob #750
     Pass AM. The nav lives in the drawer now; this is just the "what is this
     for" blurb. Lead word bolded so the three roles scan at a glance. */
  .intro {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    max-width: 40rem;
  }
  .intro p {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.65;
  }
  .intro strong {
    color: var(--ink);
    font-weight: 650;
  }
  @media (max-width: 680px) {
    .hero h1 {
      font-size: 2.5rem;
    }
  }
</style>
