---
// Help Center homepage (oxjob #354 Pass U/V/X; body reshaped oxjob #750 Pass
// AM): the front door for the whole site — a big left-justified masthead, one
// full-width search box, then three short intro paragraphs (Learn / Reference /
// Chat) mirroring the site's two-sided model. The card grid that used to live
// here moved into the left nav drawer (RailNav), so the body is now just an
// orientation blurb; the drawer is the map.
import Base from '../layouts/Base.astro';
import { CHAT_ROWS } from '../lib/nav-primary';

const forum = CHAT_ROWS.find((r) => r.title === 'Forum')!;
const report = CHAT_ROWS.find((r) => r.title === 'Report Bug')!;
---

<Base title="" description="Help, documentation, API reference, and tutorials for OpenAlex, the open catalog of the global research system.">
  <div class="wrap home">
    <section class="hero reveal">
      <h1>OpenAlex Help Center</h1>
      <p class="subtitle">
        Get help with <a href="https://openalex.org">OpenAlex</a>, a comprehensive index of the
        world's research.
      </p>
    </section>

    {/* Four orientation paragraphs (Search / Learn / Reference / Chat), Jason's
        copy (Pass AP — the hero search box became the Search paragraph; the
        top-bar pill now shows here like everywhere else). The bold lead words
        are the scan anchors, mirroring the drawer's sections. */}
    <section class="intro reveal" style="animation-delay: 0.08s">
      <p>
        <strong>Search.</strong> The fastest way to answer a specific
        question — <button class="search-link" data-search-trigger>search the full help center</button>.
      </p>
      <p>
        <strong>Learn.</strong> Just starting? Work through the five-minute <a href="/quickstart/">Quickstart</a>,
        browse the <a href="/how-to/">How-to guides</a> for simple answers, or follow
        the <a href="/tutorials/">Tutorials</a> for longer, step-by-step recipes.
      </p>
      <p>
        <strong>Reference.</strong> Dig into the details: <a href="/access/">Access</a> covers
        getting the data, pricing, and fixing errors; <a href="/data/">Data</a> defines and
        describes everything in OpenAlex; and the <a href="/api/">API</a> reference documents
        the REST API.
      </p>
      <p>
        <strong>Chat.</strong> Prefer to talk it through? Ask other users in
        the <a href={forum.href} target="_blank" rel="noopener">Google Group</a>, <a href={report.href} target="_blank" rel="noopener">report a bug</a> to
        our team, or ask your AI agent to answer from our docs — use
        the <strong>Ask AI</strong> links in the sidebar.
      </p>
    </section>
  </div>
</Base>

<style>
  .wrap.home {
    max-width: 46rem;
    margin: 0 auto;
    padding-top: 2.5rem;
  }
  /* Masthead: big, bold, left-justified (Jason 2026-08-07, screenshot spec). */
  .hero {
    text-align: left;
    margin-bottom: 2.5rem;
  }
  .hero h1 {
    margin: 0 0 0.85rem;
    font-size: 3.5rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .subtitle {
    max-width: 38rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.6;
  }
  /* The Search paragraph's trigger: a button that reads as a link and opens
     the ⌘K dialog (wired by Search.astro's [data-search-trigger]). */
  .search-link {
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    color: var(--accent);
    cursor: pointer;
  }
  .search-link:hover {
    color: var(--accent-hover);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Four short orientation paragraphs (Search / Learn / Reference / Chat).
     The nav lives in the drawer; this is just the "what is this for" blurb.
     Lead word bolded so the roles scan at a glance. */
  .intro {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    max-width: 40rem;
  }
  .intro p {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.65;
  }
  .intro strong {
    color: var(--ink);
    font-weight: 650;
  }
  @media (max-width: 680px) {
    .hero h1 {
      font-size: 2.5rem;
    }
  }
</style>
