---
// Help Center homepage (oxjob #354 Pass U/V/X; body reshaped oxjob #750 Pass
// AM): the front door for the whole site — a big left-justified masthead, one
// full-width search box, then three short intro paragraphs (Learn / Reference /
// Chat) mirroring the site's two-sided model. The card grid that used to live
// here moved into the left nav drawer (RailNav), so the body is now just an
// orientation blurb; the drawer is the map.
import Base from '../layouts/Base.astro';
import { CHAT_ROWS, ASK_AI_PROVIDERS } from '../lib/nav-primary';

const forum = CHAT_ROWS.find((r) => r.title === 'Forum')!;
const report = CHAT_ROWS.find((r) => r.title === 'Report Bug')!;
---

<Base title="" description="Help, documentation, API reference, and tutorials for OpenAlex, the open catalog of the global research system.">
  <div class="wrap home">
    <section class="hero reveal">
      <h1>OpenAlex Help Center</h1>
      <p class="subtitle">
        Get help with <a href="https://openalex.org">OpenAlex</a>, a comprehensive index of the
        world's research.
      </p>
    </section>

    {/* Four orientation paragraphs (Search / Learn / Reference / Chat), Jason's
        copy (Pass AP — the hero search box became the Search paragraph; the
        top-bar pill now shows here like everywhere else). The bold lead words
        are the scan anchors, mirroring the drawer's sections. */}
    <section class="intro reveal" style="animation-delay: 0.08s">
      <p>
        <strong>Search.</strong> The fastest way to answer a specific
        question: <button class="search-link" data-search-trigger>search the full help center</button>.
      </p>
      <p>
        <strong>Learn.</strong> Just starting? Work through the five-minute <a href="/quickstart/">Quickstart</a>,
        browse the <a href="/how-to/">How-to guides</a> for simple answers, or follow
        the <a href="/tutorials/">Tutorials</a> for longer, step-by-step recipes.
      </p>
      <p>
        <strong>Reference.</strong> Dig into the details: <a href="/access/">Access</a> covers
        getting the data, pricing, and fixing errors; <a href="/data/">Data</a> defines and
        describes OpenAlex's contents; and the <a href="/api/">API</a> reference documents
        the REST API.
      </p>
      <p class="chat-para">
        <strong>Chat.</strong> Prefer to talk it through? Ask other users in
        the <a href={forum.href} target="_blank" rel="noopener">Google Group</a>, <a href={report.href} target="_blank" rel="noopener">report a bug</a> to
        our team, or <button class="search-link" id="ask-ai-link">ask our docs with your AI</button>.
        {/* The provider menu pops under the link (the rail no longer hosts an
            Ask AI menu — Chat's one home is this paragraph, Pass AS). */}
        <span class="ai-menu" id="ai-menu" hidden>
          {ASK_AI_PROVIDERS.map((p) => (
            <a href={p.href} target="_blank" rel="noopener">{p.label}
              <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z"/></svg>
            </a>
          ))}
        </span>
      </p>
    </section>
  </div>
</Base>

<script>
  // "ask our docs with your AI" opens a small provider menu under the link.
  const aiLink = document.getElementById('ask-ai-link');
  const aiMenu = document.getElementById('ai-menu');
  if (aiLink && aiMenu) {
    aiLink.addEventListener('click', () => {
      aiMenu.hidden = !aiMenu.hidden;
      if (!aiMenu.hidden) {
        // Offsets are relative to the paragraph (position: relative below) —
        // the .reveal animation's transform makes an ancestor the containing
        // block, so page coordinates would land elsewhere.
        const para = aiMenu.parentElement!.getBoundingClientRect();
        const r = aiLink.getBoundingClientRect();
        aiMenu.style.left = `${r.left - para.left}px`;
        aiMenu.style.top = `${r.bottom - para.top + 6}px`;
      }
    });
    document.addEventListener('click', (e) => {
      if (!aiMenu.hidden && e.target !== aiLink && !aiMenu.contains(e.target as Node)) {
        aiMenu.hidden = true;
      }
    });
  }
</script>

<style>
  .wrap.home {
    max-width: 46rem;
    margin: 0 auto;
    padding-top: 2.5rem;
  }
  /* Masthead: big, bold, left-justified (Jason 2026-08-07, screenshot spec). */
  .hero {
    text-align: left;
    margin-bottom: 2.5rem;
  }
  .hero h1 {
    margin: 0 0 0.85rem;
    font-size: 3.5rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .subtitle {
    max-width: 38rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.6;
  }
  /* The Search paragraph's trigger: a button that reads as a link and opens
     the ⌘K dialog (wired by Search.astro's [data-search-trigger]). */
  .search-link {
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    color: var(--accent);
    cursor: pointer;
  }
  .search-link:hover {
    color: var(--accent-hover);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .chat-para {
    position: relative; /* containing block for the .ai-menu popover */
  }
  /* The Ask-AI provider menu, positioned under its trigger by the script. */
  .ai-menu {
    position: absolute;
    z-index: 20;
    display: flex;
    flex-direction: column;
    min-width: 9rem;
    padding: 0.25rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgb(15 18 25 / 0.12);
  }
  .ai-menu[hidden] {
    display: none;
  }
  .ai-menu a {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.6rem;
    border-radius: 6px;
    color: var(--ink);
    font-size: 0.86rem;
  }
  .ai-menu a:hover {
    background: var(--panel);
    color: var(--accent);
    text-decoration: none;
  }
  .ai-menu a svg {
    color: var(--faint);
  }

  /* Four short orientation paragraphs (Search / Learn / Reference / Chat).
     The nav lives in the drawer; this is just the "what is this for" blurb.
     Lead word bolded so the roles scan at a glance. */
  .intro {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    max-width: 40rem;
  }
  .intro p {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.65;
  }
  .intro strong {
    color: var(--ink);
    font-weight: 650;
  }
  @media (max-width: 680px) {
    .hero h1 {
      font-size: 2.5rem;
    }
  }
</style>
