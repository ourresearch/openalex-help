---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DocsShell from '../../layouts/DocsShell.astro';
import ThemeSwitch from '../../components/ThemeSwitch.astro';
import { allEntries, mdUrlFor, type Tab } from '../../lib/tabs';
import { groupEntries, groupLabelFor } from '../../lib/nav';

export async function getStaticPaths() {
  return (await allEntries()).map(({ tab, entry }) => ({
    params: { tab, slug: entry.id },
    props: { entry },
  }));
}

const tab = Astro.params.tab as Tab;
const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Help + Learn articles read like a friendly answer: narrow column, back link,
// no sidebar. Docs + API get the full app shell (grouped sidebar + right rail).
const isShell = tab === 'docs' || tab === 'api';
const labels: Record<Tab, string> = { help: 'Help', docs: 'Docs', api: 'API', learn: 'Learn' };
const groups = isShell
  ? groupEntries(tab, (await allEntries()).filter((e) => e.tab === tab).map((e) => e.entry))
  : [];
const eyebrow = groupLabelFor(tab, entry.id) ?? labels[tab];
const toc = headings.filter((h) => h.depth === 2);
const mdUrl = mdUrlFor(tab, entry);
---

{isShell ? (
  <DocsShell
    title={entry.data.title}
    description={entry.data.description}
    tab={tab}
    groups={groups}
    activeSlug={entry.id}
  >
    <article class="prose">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{entry.data.title}</h1>
      <Content />
      <div class="article-foot">
        <ThemeSwitch />
        <a class="md-link" href={mdUrl}>View as Markdown</a>
      </div>
    </article>

    <div class="rail" slot="rail">
      {toc.length > 1 && (
        <nav class="toc" aria-label="On this page">
          {toc.map((h) => (
            <a href={`#${h.slug}`}>{h.text}</a>
          ))}
        </nav>
      )}
      <div class="utils">
        <button id="copy-page" data-md-url={mdUrl}>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <span>Copy page</span>
        </button>
        <a href={mdUrl}>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          <span>View as Markdown</span>
        </a>
      </div>
    </div>
  </DocsShell>
) : (
  <Base title={entry.data.title} description={entry.data.description}>
    <div class="page">
      <article class="prose reveal">
        <a class="back" href={`/${tab}/`}>← {labels[tab]}</a>
        <h1>{entry.data.title}</h1>
        <Content />
        <div class="article-foot">
          <ThemeSwitch />
          <a class="md-link" href={mdUrl}>View as Markdown</a>
        </div>
      </article>
    </div>
  </Base>
)}

<style>
  .page {
    max-width: var(--measure);
    margin: 0 auto;
  }
  .back {
    display: inline-block;
    font-size: 0.88rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  .back:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .rail {
    position: sticky;
    top: calc(var(--nav-h) + 2.5rem);
  }
  .toc {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .toc a {
    color: var(--muted);
  }
  .toc a:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .utils {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .utils a,
  .utils button {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--muted);
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: 0.84rem;
    cursor: pointer;
  }
  .utils a:hover,
  .utils button:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .article-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .md-link {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .md-link:hover {
    color: var(--ink);
  }
</style>

<script>
  // "Copy page": fetch this page's markdown sibling and put it on the
  // clipboard — the agent-legibility story, one click for humans.
  const btn = document.getElementById('copy-page') as HTMLButtonElement | null;
  btn?.addEventListener('click', async () => {
    const label = btn.querySelector('span')!;
    try {
      const res = await fetch(btn.dataset.mdUrl!);
      await navigator.clipboard.writeText(await res.text());
      label.textContent = 'Copied!';
    } catch {
      label.textContent = 'Copy failed';
    }
    setTimeout(() => (label.textContent = 'Copy page'), 1600);
  });
</script>
