---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DocsShell from '../../layouts/DocsShell.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { allEntries, mdUrlFor, type Tab } from '../../lib/tabs';
import { groupEntries, breadcrumbsFor } from '../../lib/nav';

export async function getStaticPaths() {
  return (await allEntries()).map(({ tab, entry }) => ({
    params: { tab, slug: entry.id },
    props: { entry },
  }));
}

const tab = Astro.params.tab as Tab;
const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Help + Learn articles read like a friendly answer: narrow column, back link,
// no sidebar. Docs + API get the full app shell (grouped sidebar + right rail).
const isShell = tab === 'docs' || tab === 'api' || tab === 'entities';
const groups = isShell
  ? groupEntries(tab, (await allEntries()).filter((e) => e.tab === tab).map((e) => e.entry))
  : [];
const crumbs = breadcrumbsFor(tab, entry.id);
// Context-free page titles ("Overview", "Basic") are the Pass S naming rule —
// the nav drawer and breadcrumbs supply the context. The <title> tag has no
// such context, so append the nearest crumb there: "Overview – Querying".
const parentLabel = crumbs.length > 1 ? crumbs[crumbs.length - 1].label : undefined;
const docTitle =
  parentLabel && parentLabel !== entry.data.title
    ? `${entry.data.title} – ${parentLabel}`
    : entry.data.title;
const toc = headings.filter((h) => h.depth === 2);
const mdUrl = mdUrlFor(tab, entry);
---

{isShell ? (
  <DocsShell
    title={docTitle}
    description={entry.data.description}
    tab={tab}
    groups={groups}
    activeSlug={entry.id}
  >
    <article class="prose">
      <Breadcrumbs crumbs={crumbs} />
      <h1>{entry.data.title}</h1>
      <Content />
      <div class="article-foot">
        <a class="md-link" href={mdUrl}>View as Markdown</a>
      </div>
    </article>

    <div class="rail" slot="rail">
      {toc.length > 1 && (
        <nav class="toc" aria-label="On this page">
          {toc.map((h) => (
            <a href={`#${h.slug}`}>{h.text}</a>
          ))}
        </nav>
      )}
    </div>
  </DocsShell>
) : (
  <Base title={docTitle} description={entry.data.description}>
    <div class="page">
      <article class="prose reveal">
        <Breadcrumbs crumbs={crumbs} />
        <h1>{entry.data.title}</h1>
        <Content />
        <div class="article-foot">
          <a class="md-link" href={mdUrl}>View as Markdown</a>
        </div>
      </article>
    </div>
  </Base>
)}

<style>
  .page {
    max-width: var(--measure);
    margin: 0 auto;
  }
  .rail {
    position: sticky;
    top: calc(var(--nav-h) + 2.5rem);
  }
  .toc {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .toc a {
    color: var(--muted);
  }
  .toc a:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .article-foot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .md-link {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .md-link:hover {
    color: var(--ink);
  }
</style>
