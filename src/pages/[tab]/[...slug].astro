---
import { render } from 'astro:content';
import DocsShell from '../../layouts/DocsShell.astro';
import PageHeader from '../../components/PageHeader.astro';
import EntityMeta from '../../components/EntityMeta.astro';
import { allEntries, mdUrlFor, type Tab } from '../../lib/tabs';
import { groupEntries, breadcrumbsFor, displayTitleFor } from '../../lib/nav';
import { interfaceTagsFor } from '../../lib/facets';

export async function getStaticPaths() {
  return (await allEntries()).map(({ tab, entry }) => ({
    params: { tab, slug: entry.id },
    props: { entry },
  }));
}

const tab = Astro.params.tab as Tab;
const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Every tab now renders in the app shell (grouped sidebar + right TOC rail) —
// Tutorials joined the rest in oxjob #750, retiring the old facet/filter list.
const groups = groupEntries(tab, (await allEntries()).filter((e) => e.tab === tab).map((e) => e.entry));
const crumbs = breadcrumbsFor(tab, entry.id);
// Overview pages compose their parent's name into the H1 ("Querying Overview")
// — Jason's Pass S round 2 call. Other context-free titles ("Basic") keep the
// bare H1 (breadcrumbs supply context) but get the parent appended in the
// <title> tag, which has no context of its own.
const displayTitle = displayTitleFor(tab, entry.id, entry.data.title);
const parentLabel = crumbs.length > 1 ? crumbs[crumbs.length - 1].label : undefined;
const docTitle =
  displayTitle !== entry.data.title
    ? displayTitle
    : parentLabel && parentLabel !== entry.data.title
      ? `${entry.data.title} – ${parentLabel}`
      : entry.data.title;
const toc = headings.filter((h) => h.depth === 2);
const mdUrl = mdUrlFor(tab, entry);

// Tutorials (oxjob #750): titles are terse, so the subtitle carries the detail
// right under the H1, with non-clickable Interface tags (Web/API/…) below it.
const isTutorial = tab === 'tutorials';
const tags = isTutorial ? interfaceTagsFor(entry.id) : [];
---

<DocsShell
  title={docTitle}
  description={entry.data.description}
  tab={tab}
  groups={groups}
  activeSlug={entry.id}
>
  <article class="prose">
    <PageHeader title={displayTitle} lede={isTutorial ? entry.data.subtitle : undefined} crumbs={crumbs}>
      {tags.length > 0 && (
        <div class="tut-tags">
          {tags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      )}
    </PageHeader>
    {entry.data.entity && <EntityMeta {...entry.data.entity} />}
    <Content />
    <div class="article-foot">
      <a class="md-link" href={mdUrl}>View as Markdown</a>
    </div>
  </article>

  <div class="rail" slot="rail">
    {toc.length > 1 && (
      <nav class="toc" aria-label="On this page">
        {toc.map((h) => (
          <a href={`#${h.slug}`}>{h.text}</a>
        ))}
      </nav>
    )}
  </div>
</DocsShell>

<style>
  /* Pass X.2 uniform width: the DocsShell column grid caps content at 46rem, so
     drop the inner prose cap — every tab's content column is the same 46rem. */
  article.prose {
    max-width: none;
  }
  /* Tutorials: non-clickable Interface tags under the subtitle (oxjob #750).
     Monochrome — hairline outline, muted text. */
  .tut-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.7rem; /* sits inside PageHeader, under the subtitle */
  }
  .tag {
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--muted);
    background: none;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.05rem 0.5rem;
    white-space: nowrap;
  }
  .rail {
    position: sticky;
    top: calc(var(--nav-h) + 2.5rem);
  }
  .toc {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .toc a {
    color: var(--muted);
  }
  .toc a:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .article-foot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .md-link {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .md-link:hover {
    color: var(--ink);
  }
</style>
