---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DocsShell from '../../layouts/DocsShell.astro';
import { allEntries, mdUrlFor, type Tab } from '../../lib/tabs';
import { groupEntries, groupLabelFor } from '../../lib/nav';

export async function getStaticPaths() {
  return (await allEntries()).map(({ tab, entry }) => ({
    params: { tab, slug: entry.id },
    props: { entry },
  }));
}

const tab = Astro.params.tab as Tab;
const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Help + Learn articles read like a friendly answer: narrow column, back link,
// no sidebar. Docs + API get the full app shell (grouped sidebar + right rail).
const isShell = tab === 'docs' || tab === 'api';
const labels: Record<Tab, string> = { help: 'Help', docs: 'Docs', api: 'API', learn: 'Learn' };
const groups = isShell
  ? groupEntries(tab, (await allEntries()).filter((e) => e.tab === tab).map((e) => e.entry))
  : [];
const eyebrow = groupLabelFor(tab, entry.id) ?? labels[tab];
const toc = headings.filter((h) => h.depth === 2);
const mdUrl = mdUrlFor(tab, entry);
---

{isShell ? (
  <DocsShell
    title={entry.data.title}
    description={entry.data.description}
    tab={tab}
    groups={groups}
    activeSlug={entry.id}
  >
    <article class="prose">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{entry.data.title}</h1>
      <Content />
      <div class="article-foot">
        <a class="md-link" href={mdUrl}>View as Markdown</a>
      </div>
    </article>

    <div class="rail" slot="rail">
      {toc.length > 1 && (
        <nav class="toc" aria-label="On this page">
          {toc.map((h) => (
            <a href={`#${h.slug}`}>{h.text}</a>
          ))}
        </nav>
      )}
    </div>
  </DocsShell>
) : (
  <Base title={entry.data.title} description={entry.data.description}>
    <div class="page">
      <article class="prose reveal">
        <a class="back" href={`/${tab}/`}>← {labels[tab]}</a>
        <h1>{entry.data.title}</h1>
        <Content />
        <div class="article-foot">
          <a class="md-link" href={mdUrl}>View as Markdown</a>
        </div>
      </article>
    </div>
  </Base>
)}

<style>
  .page {
    max-width: var(--measure);
    margin: 0 auto;
  }
  .back {
    display: inline-block;
    font-size: 0.88rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  .back:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .rail {
    position: sticky;
    top: calc(var(--nav-h) + 2.5rem);
  }
  .toc {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .toc a {
    color: var(--muted);
  }
  .toc a:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .article-foot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .md-link {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .md-link:hover {
    color: var(--ink);
  }
</style>
