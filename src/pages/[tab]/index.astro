---
import Base from '../../layouts/Base.astro';
import ThemeSwitch from '../../components/ThemeSwitch.astro';
import TopicBrowser from '../../components/TopicBrowser.astro';
import { TABS, allEntries, urlFor, type Tab } from '../../lib/tabs';
import { groupEntries } from '../../lib/nav';

export async function getStaticPaths() {
  return TABS.map((tab) => ({ params: { tab } }));
}

const tab = Astro.params.tab as Tab;
const entries = (await allEntries()).filter((e) => e.tab === tab).map((e) => e.entry);
const groups = groupEntries(tab, entries);

const meta: Record<Tab, { label: string; lede: string }> = {
  help: {
    label: 'Help',
    lede: 'Plain answers to common questions — accounts, author profiles, fixing errors, exports.',
  },
  docs: {
    label: 'Docs',
    lede: 'What the OpenAlex data means, where it comes from, and how to read it.',
  },
  api: {
    label: 'API',
    lede: 'The REST API and OQL: endpoints, filters, paging, auth, rate limits.',
  },
  learn: {
    label: 'Learn',
    lede: 'Step-by-step recipes for real research questions, in the GUI or the API.',
  },
};
const isLearn = tab === 'learn';
const isHelp = tab === 'help';
---

<Base title={meta[tab].label} description={meta[tab].lede}>
  <div class="wrap" class:list={{ narrow: isHelp }}>
    <header class="tab-head reveal">
      <h1>{meta[tab].label}</h1>
      <p>{meta[tab].lede}</p>
    </header>

    {isHelp ? (
      <div class="reveal" style="animation-delay: 0.08s">
        <TopicBrowser tab={tab} groups={groups} />
      </div>
    ) : isLearn ? (
      <ul class="cards">
        {entries.map((entry, i) => (
          <li class="reveal" style={`animation-delay: ${Math.min(0.05 * (i + 1), 0.4)}s`}>
            <a href={urlFor(tab, entry)}>
              <span class="entry-title">{entry.data.title}</span>
              {entry.data.description && <span class="entry-desc">{entry.data.description}</span>}
              {entry.data.tags.length > 0 && (
                <span class="tags">
                  {entry.data.tags.filter((t) => t !== 'placeholder').map((t) => <span class="tag">{t}</span>)}
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="groups">
        {groups.map((g, gi) => (
          <section class="reveal" style={`animation-delay: ${Math.min(0.06 * (gi + 1), 0.4)}s`}>
            <h2>{g.label}</h2>
            <ul class="listing">
              {g.entries.map((entry) => (
                <li>
                  <a href={urlFor(tab, entry)}>
                    <span class="entry-title">{entry.data.title}</span>
                    {entry.data.description && <span class="entry-desc">{entry.data.description}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )}

    <div class="page-foot">
      <ThemeSwitch />
    </div>
  </div>

  <style>
    .wrap {
      max-width: 52rem;
      margin: 0 auto;
    }
    .wrap.narrow {
      max-width: 44rem;
    }
    .tab-head {
      margin-bottom: 2rem;
    }
    .tab-head h1 {
      margin: 0 0 0.4rem;
    }
    .tab-head p {
      color: var(--muted);
      margin: 0;
      font-size: 0.95rem;
    }
    .groups section {
      margin-bottom: 2rem;
    }
    .groups h2 {
      margin: 0 0 0.25rem;
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--muted);
    }
    .listing {
      list-style: none;
      margin: 0;
      padding: 0;
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden;
    }
    .listing li + li {
      border-top: 1px solid var(--line);
    }
    .listing li a {
      display: block;
      color: inherit;
      padding: 0.65rem 1rem;
      transition: background 0.15s;
    }
    .listing li a:hover {
      text-decoration: none;
      background: var(--panel);
    }
    .entry-title {
      display: block;
      font-weight: 500;
      font-size: 0.93rem;
    }
    .listing li a:hover .entry-title {
      color: var(--accent);
    }
    .entry-desc {
      display: block;
      color: var(--muted);
      font-size: 0.85rem;
      margin-top: 0.15rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .cards {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
      gap: 0.9rem;
    }
    .cards li a {
      display: block;
      color: inherit;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 1rem 1.1rem;
      height: 100%;
      background: var(--panel);
      transition: border-color 0.15s;
    }
    .cards li a:hover {
      text-decoration: none;
      border-color: var(--line-strong);
    }
    .cards .entry-desc {
      white-space: normal;
    }
    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      margin-top: 0.75rem;
    }
    .tag {
      font-size: 0.72rem;
      color: var(--muted);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 0.05rem 0.55rem;
    }
    .page-foot {
      display: flex;
      justify-content: center;
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--line);
    }
  </style>
</Base>
