---
import Base from '../../layouts/Base.astro';
import DocsShell from '../../layouts/DocsShell.astro';
import TopicBrowser from '../../components/TopicBrowser.astro';
import Card from '../../components/Card.astro';
import Icon from '../../components/Icon.astro';
import { TABS, allEntries, urlFor, type Tab, type AnyEntry } from '../../lib/tabs';
import { groupEntries, NAV_GROUPS, flatSlugs } from '../../lib/nav';
import { FACETS, facetsFor } from '../../lib/facets';

export async function getStaticPaths() {
  return TABS.map((tab) => ({ params: { tab } }));
}

const tab = Astro.params.tab as Tab;
const entries = (await allEntries()).filter((e) => e.tab === tab).map((e) => e.entry);
const groups = groupEntries(tab, entries);
const bySlug = new Map(entries.map((e) => [e.id, e]));

const meta: Record<Tab, { label: string; h1: string; lede: string }> = {
  help: {
    label: 'Help',
    h1: 'Help Center',
    lede: 'Plain answers to common questions — accounts, author profiles, fixing errors, exports.',
  },
  docs: {
    label: 'Docs',
    h1: 'OpenAlex Documentation',
    lede: 'OpenAlex is an open catalog of the global research system: papers, authors, institutions, journals, and topics, all connected. These docs explain what the data means, where it comes from, and how to read it.',
  },
  entities: {
    label: 'Entities',
    h1: 'OpenAlex Entities',
    lede: 'The people, papers, places, and concepts OpenAlex catalogs — works, authors, sources, institutions, topics, and more. Each page explains where the records come from, what judgment calls we make, and what every field means.',
  },
  api: {
    label: 'API',
    h1: 'OpenAlex API',
    lede: 'A fast, modern REST API for all of OpenAlex, plus OQL for expressive queries. Free for everyone, no key required to start. These pages cover endpoints, filters, paging, auth, and rate limits.',
  },
  recipes: {
    label: 'Recipes',
    h1: 'Recipes',
    lede: 'Step-by-step recipes for real research questions — on the web, through the API, or with your agent.',
  },
};

// Help landing (also the site's default page — / redirects here): Cursor-style
// hero search + support cards + topic accordion. "Ask AI" deep links: providers
// with working URL-prefill. The prompt tells the assistant to ground itself in
// this site; the user appends their question.
const prompt =
  'Answer my question using the OpenAlex documentation at https://help.openalex.org/ (machine index: https://help.openalex.org/llms.txt). My question: ';
const providers = [
  { label: 'Claude', href: `https://claude.ai/new?q=${encodeURIComponent(prompt)}` },
  { label: 'ChatGPT', href: `https://chatgpt.com/?q=${encodeURIComponent(prompt)}` },
  { label: 'Perplexity', href: `https://www.perplexity.ai/search?q=${encodeURIComponent(prompt)}` },
];

// Docs/API landings are Cursor-style welcome pages: "Start here" cards +
// per-group topic cards (each linking to its group's first article).
const startHere: Record<string, { slug: string; icon: string; blurb: string }[]> = {
  docs: [
    { slug: 'quickstart', icon: 'play', blurb: 'Get real data in five minutes — web, API, or agent' },
    { slug: 'overview', icon: 'cpu', blurb: 'How we build the map of the research ecosystem' },
  ],
  api: [
    { slug: 'introduction', icon: 'zap', blurb: 'What the API offers and how it is organized' },
    { slug: 'quickstart', icon: 'play', blurb: 'Your first request in under a minute' },
    { slug: 'authentication', icon: 'key', blurb: 'Keys, credits, and what is free' },
  ],
  entities: [
    { slug: 'overview', icon: 'compass', blurb: 'What entities are and how to trust their IDs' },
    { slug: 'common-fields', icon: 'list', blurb: 'The fields every entity shares' },
    { slug: 'works', icon: 'file-text', blurb: 'The core entity: every scholarly document' },
  ],
};
const groupIcons: Record<string, string> = {
  'Get started': 'compass',
  'Works & metadata': 'file-text',
  'Authors & institutions': 'users',
  'Sources & publishers': 'book',
  'Topics, metrics & aboutness': 'tag',
  'Open Access': 'unlock',
  'Repositories': 'archive',
  'Downloads & snapshot': 'download',
  'Unpaywall': 'globe',
  'Getting started': 'zap',
  'Querying': 'filter',
  'Entities': 'database',
  'Vocabularies': 'list',
  'Curation & special': 'edit',
  // Entities-tab groups
  'Overview': 'compass',
  'Native': 'database',
  'Component': 'layers',
  'Aboutness': 'tag',
  'Vocabulary': 'list',
  'User-created': 'edit',
  // Docs-tab groups (Pass R)
  'Open access': 'unlock',
  'Get the data': 'download',
  // API-tab groups (Pass R)
  'Endpoints': 'database',
};

const isShell = tab === 'docs' || tab === 'api' || tab === 'entities';
const isHelp = tab === 'help';
const isLearn = tab === 'recipes';

// Recipes: facet tags + per-value counts for the filtering sidebar.
const learnCards = isLearn ? entries.map((e) => ({ entry: e, tags: facetsFor(e.id) })) : [];
const facetCounts: Record<string, Record<string, number>> = {};
for (const f of FACETS) {
  facetCounts[f.key] = Object.fromEntries(f.values.map((v) => [v.id, 0]));
}
for (const { tags } of learnCards) {
  for (const [key, vals] of Object.entries(tags)) {
    for (const v of vals ?? []) facetCounts[key][v] = (facetCounts[key][v] ?? 0) + 1;
  }
}
const start = (startHere[tab] ?? [])
  .map(({ slug, icon, blurb }) => ({ entry: bySlug.get(slug), icon, blurb }))
  .filter((s): s is { entry: AnyEntry; icon: string; blurb: string } => Boolean(s.entry));
// Topic cards: skip "Get started" (its content is the card row above).
const topicGroups = (NAV_GROUPS[tab] ?? [])
  .filter((g) => !['Get started', 'Getting started'].includes(g.label) || tab === 'help')
  .map((g) => ({ ...g, first: flatSlugs(g).map((s) => bySlug.get(s)).find(Boolean) }))
  .filter((g) => g.first);
---

{isShell ? (
  <DocsShell title={meta[tab].label} description={meta[tab].lede} tab={tab} groups={groups}>
    <article class="prose">
      <span class="eyebrow">{tab === 'docs' ? 'Get started' : meta[tab].label}</span>
      <h1>{meta[tab].h1}</h1>
      <p class="lede">{meta[tab].lede}</p>
      {tab === 'docs' && (
        <p class="lede">
          Under the hood, OpenAlex continuously gathers records from thousands of sources — Crossref,
          ORCID, PubMed, and repositories from arXiv to Zenodo — and connects them into one open graph;
          see the <a href="/docs/overview/">Overview</a>.
        </p>
      )}

      <h2 id="start-here">Start here</h2>
      <div class="card-grid">
        {start.map(({ entry, icon, blurb }) => (
          <Card title={entry.data.title} href={urlFor(tab, entry)}>
            <Icon name={icon} slot="icon" />
            {blurb}
          </Card>
        ))}
      </div>

      <h2 id="browse-by-topic">Browse by topic</h2>
      <div class="card-grid">
        {topicGroups.map((g) => (
          <Card title={g.label} href={urlFor(tab, g.first!)}>
            <Icon name={groupIcons[g.label] ?? 'file-text'} slot="icon" />
            {g.desc}
          </Card>
        ))}
      </div>
    </article>
    <nav class="toc" slot="rail" aria-label="On this page">
      <a href="#start-here">Start here</a>
      <a href="#browse-by-topic">Browse by topic</a>
    </nav>
  </DocsShell>
) : isLearn ? (
  <Base title={meta[tab].label} description={meta[tab].lede} wide>
    <div class="learn-shell">
      <aside class="facet-bar" aria-label="Filter recipes">
        {FACETS.map((f) => (
          <div class="facet">
            <span class="facet-label">{f.label}</span>
            {f.values.map((v) => (
              <button
                class="facet-value"
                data-facet={f.key}
                data-value={v.id}
                disabled={facetCounts[f.key][v.id] === 0}
                aria-pressed="false"
              >
                <span>{v.label}</span>
                <span class="count">{facetCounts[f.key][v.id]}</span>
              </button>
            ))}
          </div>
        ))}
        <button class="clear-facets" hidden>Clear filters</button>
      </aside>

      <div class="learn-content">
        <header class="tab-head">
          <h1>{meta[tab].h1}</h1>
          <p>{meta[tab].lede}</p>
        </header>
        <ul class="cards">
          {learnCards.map(({ entry, tags }) => (
            <li
              data-task={(tags.task ?? []).join(' ')}
              data-variable={(tags.variable ?? []).join(' ')}
              data-entity={(tags.entity ?? []).join(' ')}
              data-interface={(tags.interface ?? []).join(' ')}
            >
              <a href={urlFor(tab, entry)}>
                <span class="entry-title">{entry.data.title}</span>
                {entry.data.description && <span class="entry-desc">{entry.data.description}</span>}
              </a>
            </li>
          ))}
        </ul>
        <p class="no-match" hidden>No recipes match those filters yet — the library is growing.</p>
      </div>
    </div>
  </Base>
) : (
  <Base title={meta[tab].label} description={meta[tab].lede}>
    <div class="wrap narrow help-home">
      <section class="hero reveal">
        <h1>How can we help?</h1>
        <button class="big-search" data-search-trigger aria-label="Search the docs">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
          </svg>
          <span class="placeholder">How do I find my author ID?</span>
          <kbd>⌘K</kbd>
        </button>
      </section>

      <section class="links reveal" style="animation-delay: 0.08s">
        <a class="link-card" href="https://groups.google.com/g/openalex-users">
          <span class="lc-title">Community Forum</span>
          <span class="lc-desc">Discuss with other users</span>
        </a>
        <a class="link-card" href="https://openalex.org/contact">
          <span class="lc-title">Contact Support</span>
          <span class="lc-desc">Get help from our team</span>
        </a>
        <details class="link-card ask-ai">
          <summary>
            <span class="lc-title">Ask AI</span>
            <span class="lc-desc">Open your assistant, primed with our docs</span>
          </summary>
          <div class="providers">
            {providers.map((p) => (
              <a href={p.href} target="_blank" rel="noopener">{p.label} ↗</a>
            ))}
          </div>
        </details>
      </section>

      <section class="browse reveal" style="animation-delay: 0.16s">
        <span class="browse-label">Browse by topic</span>
        <TopicBrowser tab={tab} groups={groups} />
      </section>
    </div>
  </Base>
)}

<style>
  /* --- Shell (docs/api) landing --- */
  .lede {
    color: var(--muted);
    font-size: 0.97rem;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.9rem;
    margin: 1rem 0 1.5rem;
  }
  .toc {
    position: sticky;
    top: calc(var(--nav-h) + 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .toc a {
    color: var(--muted);
  }
  .toc a:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .article-foot {
    display: flex;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  /* --- Centered (help/learn) landing --- */
  .wrap {
    max-width: 52rem;
    margin: 0 auto;
  }
  .wrap.narrow {
    max-width: 44rem;
  }
  /* --- Help landing (the site's default page) --- */
  .help-home {
    padding-top: 2.5rem;
  }
  .hero {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .hero h1 {
    margin: 0 0 2.5rem;
  }
  .big-search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 40rem;
    margin: 0 auto;
    height: 3.4rem;
    padding: 0 1rem;
    font: inherit;
    font-size: 0.95rem;
    color: var(--faint);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
    cursor: text;
    transition: border-color 0.15s;
  }
  .big-search:hover {
    border-color: var(--line-strong);
  }
  .placeholder {
    flex: 1;
    text-align: left;
  }
  .big-search kbd {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--faint);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
    background: var(--bg);
  }
  .links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.9rem;
    margin-bottom: 3rem;
    /* The .reveal animation makes each landing section a stacking context, so
       the Ask AI dropdown can't out-z-index the later .browse section without
       lifting this whole section above it. */
    position: relative;
    z-index: 10;
  }
  .link-card {
    display: block;
    text-align: center;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.9rem 1rem;
    color: inherit;
    transition: border-color 0.15s;
  }
  .link-card:hover {
    border-color: var(--line-strong);
    text-decoration: none;
  }
  .lc-title {
    display: block;
    font-size: 0.93rem;
    font-weight: 550;
  }
  .lc-desc {
    display: block;
    font-size: 0.82rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }
  .ask-ai {
    position: relative;
  }
  .ask-ai summary {
    list-style: none;
    cursor: pointer;
  }
  .ask-ai summary::-webkit-details-marker {
    display: none;
  }
  .providers {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 0.4rem);
    z-index: 5;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.12);
    padding: 0.35rem;
  }
  .providers a {
    display: block;
    padding: 0.45rem 0.75rem;
    border-radius: 7px;
    color: var(--ink);
    font-size: 0.9rem;
    text-align: left;
  }
  .providers a:hover {
    background: var(--panel);
    text-decoration: none;
    color: var(--accent);
  }
  .browse-label {
    display: block;
    font-size: 0.82rem;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }
  @media (max-width: 640px) {
    .links {
      grid-template-columns: 1fr;
    }
  }
  .tab-head {
    margin-bottom: 2rem;
  }
  .tab-head h1 {
    margin: 0 0 0.4rem;
  }
  .tab-head p {
    color: var(--muted);
    margin: 0;
    font-size: 0.95rem;
  }
  /* --- Learn: facet sidebar + recipe cards --- */
  .learn-shell {
    display: grid;
    grid-template-columns: 16.5rem minmax(0, 1fr);
    min-height: calc(100dvh - var(--nav-h));
  }
  .facet-bar {
    border-right: 1px solid var(--line);
    position: sticky;
    top: var(--nav-h);
    height: calc(100dvh - var(--nav-h));
    overflow-y: auto;
    padding: 1.75rem 1.25rem 2.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    scrollbar-width: thin;
  }
  .facet {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .facet-label {
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .facet-value {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font: inherit;
    font-size: 0.86rem;
    color: var(--ink);
    background: none;
    border: none;
    border-radius: 6px;
    padding: 0.22rem 0.5rem;
    margin-left: -0.5rem;
    cursor: pointer;
    text-align: left;
  }
  .facet-value:hover {
    color: var(--accent);
  }
  .facet-value[aria-pressed='true'] {
    color: var(--accent);
    background: var(--accent-wash);
    font-weight: 550;
  }
  .facet-value:disabled {
    color: var(--faint);
    cursor: default;
  }
  .facet-value .count {
    font-size: 0.75rem;
    color: var(--faint);
  }
  .clear-facets {
    align-self: flex-start;
    font: inherit;
    font-size: 0.82rem;
    color: var(--muted);
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.25rem 0.8rem;
    cursor: pointer;
  }
  .clear-facets:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .learn-content {
    padding: 2.5rem 2.5rem 5rem;
    max-width: 62rem;
  }
  .no-match {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 0.9rem;
  }
  .cards li a {
    display: block;
    color: inherit;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1rem 1.1rem;
    height: 100%;
    background: var(--panel);
    transition: border-color 0.15s;
  }
  .cards li a:hover {
    text-decoration: none;
    border-color: var(--line-strong);
  }
  .cards li a:hover .entry-title {
    color: var(--accent);
  }
  .entry-title {
    display: block;
    font-weight: 500;
    font-size: 0.93rem;
  }
  .entry-desc {
    display: block;
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 0.15rem;
  }
  @media (max-width: 900px) {
    .learn-shell {
      grid-template-columns: 1fr;
    }
    .facet-bar {
      position: static;
      height: auto;
      border-right: none;
      border-bottom: 1px solid var(--line);
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1.5rem 2.5rem;
    }
    .learn-content {
      padding: 2rem 1.25rem 4rem;
    }
  }
  .page-foot {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
</style>

<script>
  // Help landing: close the Ask AI menu when clicking elsewhere.
  const askAi = document.querySelector<HTMLDetailsElement>('.ask-ai');
  if (askAi) {
    document.addEventListener('click', (e) => {
      if (askAi.open && !askAi.contains(e.target as Node)) askAi.open = false;
    });
  }

  // Learn facet filtering: OR within a facet, AND across facets.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.facet-value')];
  if (buttons.length) {
    const cards = [...document.querySelectorAll<HTMLLIElement>('.learn-content .cards > li')];
    const clearBtn = document.querySelector<HTMLButtonElement>('.clear-facets')!;
    const noMatch = document.querySelector<HTMLElement>('.no-match')!;
    const selected: Record<string, Set<string>> = {};

    function apply() {
      let any = false;
      let visible = 0;
      for (const s of Object.values(selected)) if (s.size) any = true;
      for (const card of cards) {
        let show = true;
        for (const [facet, vals] of Object.entries(selected)) {
          if (!vals.size) continue;
          const cardVals = (card.dataset[facet] ?? '').split(' ').filter(Boolean);
          if (!cardVals.some((v) => vals.has(v))) {
            show = false;
            break;
          }
        }
        card.hidden = !show;
        if (show) visible++;
      }
      clearBtn.hidden = !any;
      noMatch.hidden = visible > 0;
    }

    for (const b of buttons) {
      b.addEventListener('click', () => {
        const f = b.dataset.facet!;
        const v = b.dataset.value!;
        selected[f] ??= new Set();
        if (selected[f].has(v)) {
          selected[f].delete(v);
          b.setAttribute('aria-pressed', 'false');
        } else {
          selected[f].add(v);
          b.setAttribute('aria-pressed', 'true');
        }
        apply();
      });
    }
    clearBtn.addEventListener('click', () => {
      for (const s of Object.values(selected)) s.clear();
      for (const b of buttons) b.setAttribute('aria-pressed', 'false');
      apply();
    });
  }
</script>
