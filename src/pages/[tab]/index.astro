---
import DocsShell from '../../layouts/DocsShell.astro';
import PageHeader from '../../components/PageHeader.astro';
import { TABS, allEntries, urlFor, type Tab } from '../../lib/tabs';
import { groupEntries, landingCrumbs, type ResolvedGroup } from '../../lib/nav';
import { tabDesc } from '../../lib/nav-primary';

export async function getStaticPaths() {
  return TABS.map((tab) => ({ params: { tab } }));
}

const tab = Astro.params.tab as Tab;
const entries = (await allEntries()).filter((e) => e.tab === tab).map((e) => e.entry);
const groups = groupEntries(tab, entries);

// Ledes come from nav-primary.ts (`desc`).
const meta: Record<Tab, { label: string; h1: string; lede: string }> = {
  'how-to': { label: 'How-to', h1: 'How-to guides', lede: tabDesc('/how-to/') },
  access: { label: 'Access', h1: 'Access Overview', lede: tabDesc('/access/') },
  data: { label: 'Data', h1: 'Data Overview', lede: tabDesc('/data/') },
  api: { label: 'API', h1: 'API Overview', lede: tabDesc('/api/') },
  tutorials: { label: 'Tutorials', h1: 'Tutorials', lede: tabDesc('/tutorials/') },
};

const landingHref = `/${tab}/`;

// Reference-tab landings (Pass AR — cards are gone sitewide, Jason: "prettier
// than the cards and more readable"): one homepage-style paragraph per sidebar
// section — bold linked section name, then its one-to-two-line description.
// A section whose target IS this landing (Get started → Overview) is skipped
// so the overview never links to itself.
const sectionTarget = (g: ResolvedGroup): string | undefined => {
  for (const it of g.items) {
    const href = it.href ?? (it.entry ? urlFor(tab, it.entry) : it.children[0] ? urlFor(tab, it.children[0]) : undefined);
    if (href && href !== landingHref) return href;
  }
  return undefined;
};
const sectionParas = groups
  .filter((g) => g.label) // label-less root groups live in the drawer only
  .map((g) => ({ label: g.label, desc: g.desc, href: sectionTarget(g) }))
  .filter((c): c is { label: string; desc?: string; href: string } => Boolean(c.href));

// Task tabs (How-to + Tutorials, Pass AR): an ACCORDION — one <details> per
// section, holding one row per page: bold page name, colon, regular-weight
// description (the cursor.com/help shape). Section descriptions are dropped
// deliberately (Jason: "the sections themselves are not that important").
const isTaskIndex = tab === 'how-to' || tab === 'tutorials';
const slugifyLabel = (label: string) =>
  label.toLowerCase().replace(/[^a-z0-9 -]/g, '').replace(/ /g, '-');
interface IndexRow { href: string; title: string; sub?: string }
const accordionGroups = !isTaskIndex
  ? []
  : groups
      .filter((g) => g.label) // label-less root groups live in the drawer only
      .map((g) => ({
        label: g.label,
        id: slugifyLabel(g.label),
        rows: g.items
          .map((it): IndexRow | undefined => {
            const href = it.href ?? (it.entry ? urlFor(tab, it.entry) : undefined);
            // Skip the "Get started" Overview self-link — it IS this page.
            if (!href || href === landingHref) return undefined;
            return {
              href,
              title: it.entry?.data.title ?? it.label,
              sub: it.entry?.data.card ?? it.entry?.data.subtitle ?? it.entry?.data.description,
            };
          })
          .filter((r): r is IndexRow => Boolean(r)),
      }))
      .filter((g) => g.rows.length > 0);
---

<DocsShell title={meta[tab].h1} description={meta[tab].lede} tab={tab} groups={groups}>
  <article class="prose" data-pagefind-body data-pagefind-meta={`eyebrow:${meta[tab].label}`}>
    <PageHeader title={meta[tab].h1} lede={meta[tab].lede} crumbs={landingCrumbs(tab)} />

    {tab === 'data' && (
      <Fragment>
        <p>
          OpenAlex data is laid out as a <strong>graph</strong>: about twenty types of connected
          entities. <a href="/data/works/">Works</a> — papers, books, datasets — sit at the
          center, linked to the <a href="/data/authors/">authors</a> who wrote them, the{' '}
          <a href="/data/sources/">sources</a> that published them, the{' '}
          <a href="/data/institutions/">institutions</a> those authors belong to, the{' '}
          <a href="/data/topics/">topics</a> they're about, and more.
        </p>
        <p>
          This reference is organized by entity. Each page explains what one entity type is,
          where its records come from — including the judgment calls we make — and what every
          attribute on it means.
        </p>
      </Fragment>
    )}

    {tab === 'how-to' && (
      <p>
        Each guide here answers one practical question — finding an ID, fixing a bad record,
        getting your journal indexed — in a few minutes of reading. If you want a worked,
        end-to-end walkthrough of a whole project instead, head to the{' '}
        <a href="/tutorials/">Tutorials</a>.
      </p>
    )}

    {tab === 'tutorials' && (
      <p>
        Each tutorial walks a real project end to end, step by step — new to OpenAlex, start
        with the <a href="/quickstart/">Quickstart</a>. If you're after a fast
        answer to a single task instead, the <a href="/how-to/">How-to guides</a> are shorter.
      </p>
    )}

    {/* data-pagefind-ignore on the index: label+blurb text runs together in
        search snippets, and every row's page is indexed on its own. */}
    {isTaskIndex ? (
      <div class="accordion" data-pagefind-ignore>
        {accordionGroups.map((g) => (
          <details id={g.id}>
            <summary>
              <span>{g.label}</span>
              <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
            </summary>
            <div class="rows">
              {g.rows.map((r) => (
                <a class="row" href={r.href}>
                  <strong>{r.title}</strong>{r.sub && <Fragment>: <span class="row-sub">{r.sub}</span></Fragment>}
                </a>
              ))}
            </div>
          </details>
        ))}
      </div>
    ) : (
      <div class="sections" data-pagefind-ignore>
        {sectionParas.map((c) => (
          <p class="section-p">
            <strong><a href={c.href}>{c.label}.</a></strong> {c.desc}
          </p>
        ))}
      </div>
    )}
  </article>
</DocsShell>

<style>
  /* Shell landing (all tabs). Pass X.2 uniform width: the shell's grid caps
     the column at 46rem; drop the inner prose cap so this matches articles. */
  article.prose {
    max-width: none;
  }

  /* Reference tabs: homepage-style section paragraphs (bold linked lead +
     one-to-two-line description) — the card grid is gone (Pass AR). */
  .sections {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    margin: 1.75rem 0 1.5rem;
    max-width: 40rem;
  }
  .section-p {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.65;
  }
  .section-p strong a {
    color: var(--ink);
    font-weight: 650;
  }
  .section-p strong a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  /* Task tabs: the accordion (Pass AR — cursor.com/help shape). */
  .accordion {
    margin: 1.75rem 0 1.5rem;
    border-top: 1px solid var(--line);
  }
  .accordion details {
    border-bottom: 1px solid var(--line);
  }
  .accordion summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem 0.25rem;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .accordion summary::-webkit-details-marker {
    display: none;
  }
  .accordion summary:hover {
    color: var(--accent);
  }
  .chev {
    flex: none;
    color: var(--faint);
    transition: transform 0.15s;
  }
  .accordion details[open] > summary .chev {
    transform: rotate(90deg);
  }
  .rows {
    display: flex;
    flex-direction: column;
    padding: 0 0.25rem 0.85rem;
  }
  .row {
    padding: 0.4rem 0;
    color: var(--ink);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .row:hover {
    text-decoration: none;
  }
  .row strong {
    font-weight: 650;
  }
  .row:hover strong {
    color: var(--accent);
  }
  .row-sub {
    color: var(--muted);
  }
</style>
