---
import Base from '../../layouts/Base.astro';
import DocsShell from '../../layouts/DocsShell.astro';
import Card from '../../components/Card.astro';
import Icon from '../../components/Icon.astro';
import { TABS, allEntries, urlFor, type Tab, type AnyEntry } from '../../lib/tabs';
import { groupEntries, NAV_GROUPS, flatSlugs } from '../../lib/nav';
import { facetConfig } from '../../lib/facets';

export async function getStaticPaths() {
  return TABS.map((tab) => ({ params: { tab } }));
}

const tab = Astro.params.tab as Tab;
const entries = (await allEntries()).filter((e) => e.tab === tab).map((e) => e.entry);
const groups = groupEntries(tab, entries);
const bySlug = new Map(entries.map((e) => [e.id, e]));

const meta: Record<Tab, { label: string; h1: string; lede: string; empty?: string }> = {
  help: {
    label: 'FAQ',
    h1: 'Frequently asked questions',
    lede: 'The questions users actually ask us — accounts, author profiles, data quirks, exports — answered plainly.',
    empty: 'No questions match those filters.',
  },
  docs: {
    label: 'Docs',
    h1: 'OpenAlex Documentation',
    lede: 'How the dataset works and how to use it — querying, open access, and every way to get the data.',
  },
  entities: {
    label: 'Entities',
    h1: 'OpenAlex Entities',
    lede: 'The people, papers, places, and concepts OpenAlex catalogs — works, authors, sources, institutions, topics, and more. Each page explains where the records come from, what judgment calls we make, and what every field means.',
  },
  api: {
    label: 'API',
    h1: 'OpenAlex API',
    lede: 'A fast, modern REST API for all of OpenAlex, plus OQL for expressive queries. Free for everyone, no key required to start. These pages cover endpoints, filters, paging, auth, and rate limits.',
  },
  recipes: {
    label: 'Recipes',
    h1: 'Recipes',
    lede: 'Step-by-step recipes for real research questions — on the web, through the API, or with your agent.',
    empty: 'No recipes match those filters yet — the library is growing.',
  },
};

// Docs/API landings are Cursor-style welcome pages: "Start here" cards +
// per-group topic cards (each linking to its group's first article).
const startHere: Record<string, { slug: string; icon: string; blurb: string }[]> = {
  docs: [
    { slug: 'quickstart', icon: 'play', blurb: 'Get real data in five minutes — web, API, or agent' },
    { slug: 'overview', icon: 'cpu', blurb: 'How we build the map of the research ecosystem' },
  ],
  api: [
    { slug: 'introduction', icon: 'zap', blurb: 'What the API offers and how it is organized' },
    { slug: 'quickstart', icon: 'play', blurb: 'Your first request in under a minute' },
    { slug: 'authentication', icon: 'key', blurb: 'Keys, credits, and what is free' },
  ],
  entities: [
    { slug: 'overview', icon: 'compass', blurb: 'What entities are and how to trust their IDs' },
    { slug: 'common-fields', icon: 'list', blurb: 'The fields every entity shares' },
    { slug: 'works', icon: 'file-text', blurb: 'The core entity: every scholarly document' },
  ],
};
const groupIcons: Record<string, string> = {
  'Get started': 'compass',
  'Getting started': 'zap',
  'Querying': 'filter',
  'Curation & special': 'edit',
  // Entities-tab groups
  'Overview': 'compass',
  'Native': 'database',
  'Component': 'layers',
  'Aboutness': 'tag',
  'Vocabulary': 'list',
  'User-created': 'edit',
  // Docs-tab groups (Pass R)
  'Open access': 'unlock',
  'Get the data': 'download',
  // API-tab groups (Pass R)
  'Endpoints': 'database',
};

const isShell = tab === 'docs' || tab === 'api' || tab === 'entities';

// Bucket tabs (FAQ + Recipes, Pass U): a flat filterable list, no curated
// hierarchy — facet tags + per-value counts for the filtering sidebar.
const bucket = facetConfig(tab);
const bucketCards = bucket ? entries.map((e) => ({ entry: e, tags: bucket.tagsFor(e.id) })) : [];
const facetCounts: Record<string, Record<string, number>> = {};
if (bucket) {
  for (const f of bucket.facets) {
    facetCounts[f.key] = Object.fromEntries(f.values.map((v) => [v.id, 0]));
  }
  for (const { tags } of bucketCards) {
    for (const [key, vals] of Object.entries(tags)) {
      for (const v of vals ?? []) facetCounts[key][v] = (facetCounts[key][v] ?? 0) + 1;
    }
  }
}
const start = (startHere[tab] ?? [])
  .map(({ slug, icon, blurb }) => ({ entry: bySlug.get(slug), icon, blurb }))
  .filter((s): s is { entry: AnyEntry; icon: string; blurb: string } => Boolean(s.entry));
// Topic cards: skip "Get started" (its content is the card row above).
const topicGroups = (NAV_GROUPS[tab] ?? [])
  .filter((g) => !['Get started', 'Getting started'].includes(g.label))
  .map((g) => ({ ...g, first: flatSlugs(g).map((s) => bySlug.get(s)).find(Boolean) }))
  .filter((g) => g.first);
---

{isShell ? (
  <DocsShell title={meta[tab].label} description={meta[tab].lede} tab={tab} groups={groups}>
    <article class="prose">
      <span class="eyebrow">{tab === 'docs' ? 'Get started' : meta[tab].label}</span>
      <h1>{meta[tab].h1}</h1>
      <p class="lede">{meta[tab].lede}</p>

      <h2 id="start-here">Start here</h2>
      <div class="card-grid">
        {start.map(({ entry, icon, blurb }) => (
          <Card title={entry.data.title} href={urlFor(tab, entry)}>
            <Icon name={icon} slot="icon" />
            {blurb}
          </Card>
        ))}
      </div>

      <h2 id="browse-by-topic">Browse by topic</h2>
      <div class="card-grid">
        {topicGroups.map((g) => (
          <Card title={g.label} href={urlFor(tab, g.first!)}>
            <Icon name={groupIcons[g.label] ?? 'file-text'} slot="icon" />
            {g.desc}
          </Card>
        ))}
      </div>
    </article>
    <nav class="toc" slot="rail" aria-label="On this page">
      <a href="#start-here">Start here</a>
      <a href="#browse-by-topic">Browse by topic</a>
    </nav>
  </DocsShell>
) : (
  <Base title={meta[tab].label} description={meta[tab].lede} wide>
    <div class="learn-shell">
      <aside class="facet-bar" aria-label={`Filter ${meta[tab].label}`}>
        {bucket!.facets.map((f) => (
          <div class="facet">
            <span class="facet-label">{f.label}</span>
            {f.values.map((v) => (
              <button
                class="facet-value"
                data-facet={f.key}
                data-value={v.id}
                disabled={facetCounts[f.key][v.id] === 0}
                aria-pressed="false"
              >
                <span>{v.label}</span>
                <span class="count">{facetCounts[f.key][v.id]}</span>
              </button>
            ))}
          </div>
        ))}
        <button class="clear-facets" hidden>Clear filters</button>
      </aside>

      <div class="learn-content">
        <header class="tab-head">
          <h1>{meta[tab].h1}</h1>
          <p>{meta[tab].lede}</p>
        </header>
        <ul class="cards">
          {bucketCards.map(({ entry, tags }) => (
            <li
              {...Object.fromEntries(
                bucket!.facets.map((f) => [`data-${f.key}`, (tags[f.key] ?? []).join(' ')])
              )}
            >
              <a href={urlFor(tab, entry)}>
                <span class="entry-title">{entry.data.title}</span>
                {entry.data.description && <span class="entry-desc">{entry.data.description}</span>}
              </a>
            </li>
          ))}
        </ul>
        <p class="no-match" hidden>{meta[tab].empty ?? 'No articles match those filters.'}</p>
      </div>
    </div>
  </Base>
)}

<style>
  /* --- Shell (docs/api/entities) landing --- */
  .lede {
    color: var(--muted);
    font-size: 0.97rem;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.9rem;
    margin: 1rem 0 1.5rem;
  }
  .toc {
    position: sticky;
    top: calc(var(--nav-h) + 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .toc a {
    color: var(--muted);
  }
  .toc a:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .article-foot {
    display: flex;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .tab-head {
    margin-bottom: 2rem;
  }
  .tab-head h1 {
    margin: 0 0 0.4rem;
  }
  .tab-head p {
    color: var(--muted);
    margin: 0;
    font-size: 0.95rem;
  }
  /* --- Bucket tabs (FAQ + Recipes): facet sidebar + article cards --- */
  .learn-shell {
    display: grid;
    grid-template-columns: 16.5rem minmax(0, 1fr);
    min-height: calc(100dvh - var(--nav-h));
  }
  .facet-bar {
    border-right: 1px solid var(--line);
    position: sticky;
    top: var(--nav-h);
    height: calc(100dvh - var(--nav-h));
    overflow-y: auto;
    padding: 1.75rem 1.25rem 2.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    scrollbar-width: thin;
  }
  .facet {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .facet-label {
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .facet-value {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font: inherit;
    font-size: 0.86rem;
    color: var(--ink);
    background: none;
    border: none;
    border-radius: 6px;
    padding: 0.22rem 0.5rem;
    margin-left: -0.5rem;
    cursor: pointer;
    text-align: left;
  }
  .facet-value:hover {
    color: var(--accent);
  }
  .facet-value[aria-pressed='true'] {
    color: var(--accent);
    background: var(--accent-wash);
    font-weight: 550;
  }
  .facet-value:disabled {
    color: var(--faint);
    cursor: default;
  }
  .facet-value .count {
    font-size: 0.75rem;
    color: var(--faint);
  }
  .clear-facets {
    align-self: flex-start;
    font: inherit;
    font-size: 0.82rem;
    color: var(--muted);
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.25rem 0.8rem;
    cursor: pointer;
  }
  .clear-facets:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .learn-content {
    padding: 2.5rem 2.5rem 5rem;
    max-width: 62rem;
  }
  .no-match {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 0.9rem;
  }
  .cards li a {
    display: block;
    color: inherit;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1rem 1.1rem;
    height: 100%;
    background: var(--panel);
    transition: border-color 0.15s;
  }
  .cards li a:hover {
    text-decoration: none;
    border-color: var(--line-strong);
  }
  .cards li a:hover .entry-title {
    color: var(--accent);
  }
  .entry-title {
    display: block;
    font-weight: 500;
    font-size: 0.93rem;
  }
  .entry-desc {
    display: block;
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 0.15rem;
  }
  @media (max-width: 900px) {
    .learn-shell {
      grid-template-columns: 1fr;
    }
    .facet-bar {
      position: static;
      height: auto;
      border-right: none;
      border-bottom: 1px solid var(--line);
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1.5rem 2.5rem;
    }
    .learn-content {
      padding: 2rem 1.25rem 4rem;
    }
  }
  .page-foot {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
</style>

<script>
  // Bucket-tab facet filtering: OR within a facet, AND across facets.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.facet-value')];
  if (buttons.length) {
    const cards = [...document.querySelectorAll<HTMLLIElement>('.learn-content .cards > li')];
    const clearBtn = document.querySelector<HTMLButtonElement>('.clear-facets')!;
    const noMatch = document.querySelector<HTMLElement>('.no-match')!;
    const selected: Record<string, Set<string>> = {};

    function apply() {
      let any = false;
      let visible = 0;
      for (const s of Object.values(selected)) if (s.size) any = true;
      for (const card of cards) {
        let show = true;
        for (const [facet, vals] of Object.entries(selected)) {
          if (!vals.size) continue;
          const cardVals = (card.dataset[facet] ?? '').split(' ').filter(Boolean);
          if (!cardVals.some((v) => vals.has(v))) {
            show = false;
            break;
          }
        }
        card.hidden = !show;
        if (show) visible++;
      }
      clearBtn.hidden = !any;
      noMatch.hidden = visible > 0;
    }

    for (const b of buttons) {
      b.addEventListener('click', () => {
        const f = b.dataset.facet!;
        const v = b.dataset.value!;
        selected[f] ??= new Set();
        if (selected[f].has(v)) {
          selected[f].delete(v);
          b.setAttribute('aria-pressed', 'false');
        } else {
          selected[f].add(v);
          b.setAttribute('aria-pressed', 'true');
        }
        apply();
      });
    }
    clearBtn.addEventListener('click', () => {
      for (const s of Object.values(selected)) s.clear();
      for (const b of buttons) b.setAttribute('aria-pressed', 'false');
      apply();
    });
  }
</script>
