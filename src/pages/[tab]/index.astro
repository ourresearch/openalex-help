---
import DocsShell from '../../layouts/DocsShell.astro';
import Card from '../../components/Card.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import { TABS, allEntries, urlFor, type Tab } from '../../lib/tabs';
import { groupEntries, landingCrumbs, type ResolvedGroup } from '../../lib/nav';

export async function getStaticPaths() {
  return TABS.map((tab) => ({ params: { tab } }));
}

const tab = Astro.params.tab as Tab;
const entries = (await allEntries()).filter((e) => e.tab === tab).map((e) => e.entry);
const groups = groupEntries(tab, entries);

const meta: Record<Tab, { label: string; h1: string; lede: string }> = {
  'how-to': {
    label: 'How-to',
    h1: 'How-to guides',
    lede: 'Short, practical guides to the most common OpenAlex tasks.',
  },
  access: {
    label: 'Access',
    h1: 'Access Overview',
    lede: 'Every way in and out of OpenAlex — how to ask questions, how to get the data, what it costs, and how to fix what’s wrong.',
  },
  data: {
    label: 'Data',
    h1: 'Data Overview',
    lede: 'What is in OpenAlex, where it comes from, and what every attribute means.',
  },
  api: {
    label: 'API',
    h1: 'API Overview',
    lede: 'A fast, modern REST API for all of OpenAlex — plus OQL for more expressive queries. Free to start, no key required.',
  },
  tutorials: {
    label: 'Tutorials',
    h1: 'Tutorials',
    lede: 'Step-by-step instructions for real use cases — on the web, through the API, or with your agent.',
  },
};

// Reference-tab landings (Pass W) are simple overview pages: header + subtitle
// + one card per sidebar section (no "Start here"/"Browse by topic" split).
// Each card links to its section's natural landing (a static link, else the
// section's first article). A section whose target IS this landing (docs'
// "Get started" → /docs/) is skipped so the overview never links to itself.
const groupIcons: Record<string, string> = {
  'Get started': 'compass',
  'How it works': 'cpu',
  'Querying': 'filter',
  'Curation & special': 'edit',
  // Entities-tab groups
  'Native': 'database',
  'Component': 'layers',
  'Aboutness': 'tag',
  'Vocabulary': 'list',
  'User-created': 'edit',
  // Access-tab groups
  'Get the data': 'download',
  'Fixing errors': 'edit',
  // How-to-tab groups (shell conversion, oxjob #750)
  'Using OpenAlex': 'zap',
  'Journals & repositories': 'book',
  'Community & support': 'users',
  // API-tab groups
  'Endpoints': 'database',
  'Reference': 'book',
  // Tutorials-tab groups (shell conversion, oxjob #750)
  'Output & subjects': 'shape-outline',
  'Citations & impact': 'compass',
  'Open access': 'unlock',
  'Collaboration': 'users',
  'Journals & profiles': 'book',
  'Bulk data & API': 'download',
};

const landingHref = `/${tab}/`;
// First item target in a section that isn't the landing itself, so e.g. docs'
// "Get started" card (whose Overview link IS this landing) falls through to
// Quickstart rather than pointing back at this page.
const sectionTarget = (g: ResolvedGroup): string | undefined => {
  for (const it of g.items) {
    const href = it.href ?? (it.entry ? urlFor(tab, it.entry) : it.children[0] ? urlFor(tab, it.children[0]) : undefined);
    if (href && href !== landingHref) return href;
  }
  return undefined;
};
const sectionCards = groups
  .map((g) => ({ label: g.label, desc: g.desc, href: sectionTarget(g) }))
  .filter((c): c is { label: string; desc?: string; href: string } => Boolean(c.href));

// Task tabs (How-to + Tutorials, oxjob #750): the landing IS the section
// overview. Cards are for sections that have something to say (a reference
// section's overview page); these sections are just groupings of tasks, so a
// card had nowhere to point — it fell through to the section's *first
// article*, a mislabeled link. Instead the landing renders the full grouped
// index: every page, under its section heading. Headings carry stable ids
// (github-slugger form, same as article heading anchors) so the homepage and
// reference pages can deep-link a section, e.g. /how-to/#fixing-errors.
const isTaskIndex = tab === 'how-to' || tab === 'tutorials';
// Mirrors github-slugger for our label alphabet ("Journals & repositories" →
// "journals--repositories") so section anchors match markdown heading anchors.
const slugifyLabel = (label: string) =>
  label.toLowerCase().replace(/[^a-z0-9 -]/g, '').replace(/ /g, '-');
interface IndexRow { href: string; title: string; sub?: string }
const indexGroups = !isTaskIndex
  ? []
  : groups
      .map((g) => ({
        label: g.label,
        desc: g.desc,
        id: slugifyLabel(g.label),
        rows: g.items
          .map((it): IndexRow | undefined => {
            const href = it.href ?? (it.entry ? urlFor(tab, it.entry) : undefined);
            // Skip the "Get started" Overview self-link — it IS this page.
            if (!href || href === landingHref) return undefined;
            return {
              href,
              title: it.entry?.data.title ?? it.label,
              sub: it.entry?.data.subtitle ?? it.entry?.data.description,
            };
          })
          .filter((r): r is IndexRow => Boolean(r)),
      }))
      .filter((g) => g.rows.length > 0);

// Every tab now renders in the app shell (nav drawer + grouped landing) —
// Tutorials joined the rest in oxjob #750, retiring the facet "bucket" list.
---

<DocsShell title={meta[tab].h1} description={meta[tab].lede} tab={tab} groups={groups}>
  <article class="prose" data-pagefind-body data-pagefind-meta={`eyebrow:${meta[tab].label}`}>
    <PageHeader title={meta[tab].h1} lede={meta[tab].lede} crumbs={landingCrumbs(tab)} />

    {tab === 'data' && (
      <Fragment>
        <p>
          OpenAlex data is laid out as a <strong>graph</strong>: about twenty types of connected
          entities. <a href="/data/works/">Works</a> — papers, books, datasets — sit at the
          center, linked to the <a href="/data/authors/">authors</a> who wrote them, the{' '}
          <a href="/data/sources/">sources</a> that published them, the{' '}
          <a href="/data/institutions/">institutions</a> those authors belong to, the{' '}
          <a href="/data/topics/">topics</a> they're about, and more.
        </p>
        <p>
          This reference is organized by entity. Each page explains what one entity type is,
          where its records come from — including the judgment calls we make — and what every
          attribute on it means.
        </p>
      </Fragment>
    )}

    {tab === 'how-to' && (
      <p>
        Each guide here answers one practical question — finding an ID, fixing a bad record,
        getting your journal indexed — in a few minutes of reading. If you want a worked,
        end-to-end walkthrough of a whole project instead, head to the{' '}
        <a href="/tutorials/">Tutorials</a>.
      </p>
    )}

    {tab === 'tutorials' && (
      <p>
        Each tutorial walks a real project end to end, step by step — new to OpenAlex, start
        with the <a href="/tutorials/quickstart/">Quick Start</a>. If you're after a fast
        answer to a single task instead, the <a href="/how-to/">How-to guides</a> are shorter.
      </p>
    )}

    {/* data-pagefind-ignore on the index/cards: their label+blurb text runs
        together in search snippets ("QueryingThe ways to ask OpenAlex…"), and
        every row's page is indexed on its own. The landing is still findable
        by its H1, lede, and intro prose. (oxjob #750) */}
    {isTaskIndex ? (
      <div data-pagefind-ignore>
        {indexGroups.map((g) => (
          <section class="topic">
            <h2 id={g.id}>{g.label}</h2>
            {g.desc && <p class="topic-desc">{g.desc}</p>}
            <ul class="rows">
              {g.rows.map((r) => (
                <li>
                  <a href={r.href}>
                    <span class="row-title">{r.title}</span>
                    {r.sub && <span class="row-sub">{r.sub}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    ) : (
      <div class="card-grid" data-pagefind-ignore>
        {sectionCards.map((c) => (
          <Card title={c.label} href={c.href}>
            <Icon name={groupIcons[c.label] ?? 'file-text'} slot="icon" />
            {c.desc}
          </Card>
        ))}
      </div>
    )}
  </article>
</DocsShell>

<style>
  /* Shell landing (all tabs): header + one card per sidebar section. */
  /* Pass X.2 uniform width: the shell's grid caps the column at 46rem; drop
     the inner prose cap so this matches the article pages exactly. */
  article.prose {
    max-width: none;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.9rem;
    margin: 0 0 1.5rem;
  }

  /* Task-tab grouped index (How-to + Tutorials, oxjob #750). Section h2s keep
     the prose heading look; rows are the #752 hairline list. */
  .topic {
    margin-bottom: 2.25rem;
  }
  .topic-desc {
    color: var(--muted);
    font-size: 0.88rem;
    margin: -0.35rem 0 0.75rem;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows li {
    border-top: 1px solid var(--line);
  }
  .rows li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .rows li a {
    display: block;
    color: inherit;
    padding: 0.8rem 0.4rem;
  }
  .rows li a:hover {
    text-decoration: none;
  }
  .rows li a:hover .row-title {
    color: var(--accent);
  }
  .row-title {
    display: block;
    font-weight: 500;
    font-size: 0.95rem;
  }
  .row-sub {
    display: block;
    color: var(--muted);
    font-size: 0.86rem;
    margin-top: 0.15rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
