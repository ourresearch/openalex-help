---
// "Last updated <date>" for the article foot (oxjob #637): readers — CNRS/Inist
// trainers especially — need to tell at a glance whether a page still reflects
// the product.
//
// The value is the article's hand-maintained `updated:` frontmatter (required
// by the schema). A writer bumps it when they edit the page. Deliberately not
// derived from git: it's a claim the author makes about the page, and a human
// can tell a real revision from a typo fix or a rename in a way a commit log
// can't.
interface Props {
  /** `YYYY-MM-DD` from the article's `updated:` frontmatter. */
  date: string;
}
const { date } = Astro.props;

// Server-rendered text is the no-JS fallback for an English site; the inline
// script below re-renders it in the reader's locale. Pinned to UTC so the build
// machine's timezone — an accident of where CI runs — can't shift the day.
const fallback = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${date}T00:00:00Z`));
---

<p class="updated">Last updated <time datetime={date} data-localize-date>{fallback}</time></p>

<!-- is:inline and adjacent to the markup, so it runs during parse (before
     first paint) and the en-US fallback never flashes in a French browser. -->
<script is:inline>
  (() => {
    const el = document.querySelector('time[data-localize-date]');
    if (!el) return;
    const [y, m, d] = el.dateTime.split('-').map(Number);
    if (!y || !m || !d) return;
    // Build the date in LOCAL time. `new Date('2026-08-11')` parses as UTC
    // midnight, which renders as the 10th for every reader behind Greenwich.
    const local = new Date(y, m - 1, d);
    const locales = navigator.languages?.length ? navigator.languages : undefined;
    try {
      el.textContent = local.toLocaleDateString(locales, {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
    } catch {
      // Bad Accept-Language → RangeError. Keep the server's en-US string.
    }
  })();
</script>

<style>
  .updated {
    margin: 0;
    font-size: 0.82rem;
    color: var(--faint);
  }
</style>
