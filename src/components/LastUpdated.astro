---
// "Last updated <date>" for the article foot (oxjob #637): readers — CNRS/Inist
// trainers especially — need to tell at a glance whether a page still reflects
// the product. Date only, no time of day.
//
// We store the INSTANT of the edit and let each browser render it (Jason,
// 2026-08-16): the instant is the fact, a calendar date is a projection of it,
// so the projection belongs at the display end rather than baked into the
// build. A reader east of the author can therefore see the following day —
// that's the instant rendered in their own frame, not a bug.
interface Props {
  /**
   * `<time datetime>` value: either a full instant with offset
   * (`2026-08-11T19:09:05-05:00`, from git) or a bare `YYYY-MM-DD` (from a
   * frontmatter `updated:` override, which asserts no time of day).
   */
  date: string;
}
const { date } = Astro.props;

// Server-rendered text is the no-JS fallback for an English site. An instant is
// pinned to UTC here because the build machine's zone is an accident of where
// CI runs; the inline script re-renders it in the reader's actual zone. A bare
// date is formatted as-is — there's no instant to convert.
const dateOnly = !date.includes('T');
const fallback = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(dateOnly ? `${date}T00:00:00Z` : date));
---

<p class="updated">Last updated <time datetime={date} data-localize-date>{fallback}</time></p>

<!-- is:inline and adjacent to the markup, so it runs during parse (before
     first paint) and the en-US fallback never flashes in a French browser. -->
<script is:inline>
  (() => {
    const el = document.querySelector('time[data-localize-date]');
    if (!el) return;
    const raw = el.dateTime;
    // A full instant converts to the reader's zone; a bare YYYY-MM-DD asserts a
    // calendar date, so build it in LOCAL time to keep it that date. Parsing it
    // as `new Date('2026-08-11')` would read UTC midnight and shift it a day
    // back for every reader behind Greenwich.
    let d;
    if (raw.includes('T')) {
      d = new Date(raw);
    } else {
      const [y, m, day] = raw.split('-').map(Number);
      if (!y || !m || !day) return;
      d = new Date(y, m - 1, day);
    }
    if (isNaN(d.getTime())) return;
    const locales = navigator.languages?.length ? navigator.languages : undefined;
    try {
      el.textContent = d.toLocaleDateString(locales, {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
    } catch {
      // Bad Accept-Language → RangeError. Keep the server's en-US string.
    }
  })();
</script>

<style>
  .updated {
    margin: 0;
    font-size: 0.82rem;
    color: var(--faint);
  }
</style>
