---
// Cursor-style System / Light / Dark icon trio. Explicit choice sets
// html.light or html.dark + localStorage 'theme'; System clears both and
// falls back to prefers-color-scheme (see global.css). The pre-paint
// application lives in Base.astro's inline head script.
---

<div class="theme-switch" role="group" aria-label="Color theme">
  <button data-theme-value="system" aria-label="System theme" title="System theme">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
  </button>
  <button data-theme-value="light" aria-label="Light theme" title="Light theme">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22"/><line x1="4.9" y1="4.9" x2="6.3" y2="6.3"/><line x1="17.7" y1="17.7" x2="19.1" y2="19.1"/><line x1="2" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22" y2="12"/><line x1="4.9" y1="19.1" x2="6.3" y2="17.7"/><line x1="17.7" y1="6.3" x2="19.1" y2="4.9"/></svg>
  </button>
  <button data-theme-value="dark" aria-label="Dark theme" title="Dark theme">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
  </button>
</div>

<style>
  .theme-switch {
    display: inline-flex;
    gap: 0.25rem;
  }
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid transparent;
    border-radius: 6px;
    background: none;
    color: var(--faint);
    cursor: pointer;
    padding: 0;
  }
  button:hover {
    color: var(--ink);
    background: var(--panel);
  }
  button[aria-pressed='true'] {
    color: var(--ink);
    border-color: var(--line);
    background: var(--panel);
  }
</style>

<script>
  function currentTheme(): string {
    return localStorage.getItem('theme') || 'system';
  }
  function applyTheme(value: string) {
    document.documentElement.classList.remove('light', 'dark');
    if (value === 'light' || value === 'dark') {
      document.documentElement.classList.add(value);
      localStorage.setItem('theme', value);
    } else {
      localStorage.removeItem('theme');
    }
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-theme-value]')) {
      b.setAttribute('aria-pressed', String(b.dataset.themeValue === value));
    }
  }
  applyTheme(currentTheme());
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-theme-value]')) {
    b.addEventListener('click', () => applyTheme(b.dataset.themeValue!));
  }
</script>
