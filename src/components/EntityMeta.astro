---
// Structured metadata line at the top of every Data-tab entity page
// (oxjob #354 Pass Z, single-row form per Jason's red-pen 2026-08-07):
//   Eg: indexes/doaj   Count: 5   Links to: works, sources
// One row, no borders, all values plain monospace (no code chrome). Groups
// render only when their data exists: component entities get just Links to,
// user-created entities just an unlinked Eg.
import { entityCount } from '../lib/entityCounts';

interface Props {
  example?: string;
  api?: string;
  serp?: string;
  linksTo?: string[];
  // The card renders twice per page: a desktop copy BEFORE the page header
  // (floated right, so the header + intro wrap around it) and a `mobile` copy
  // after it (full width, shown only <700px where the float is hidden).
  mobile?: boolean;
}
const { example, api, serp = Astro.props.api, linksTo = [], mobile = false } = Astro.props;

const count = api ? await entityCount(api) : null;

// Example link: native short IDs (W2741809807) get the explicit GUI entity page;
// namespaced IDs (countries/US) are already a path on openalex.org; anything
// else (col_…, cur-…) has no public web page and renders unlinked.
let exampleUrl: string | null = null;
if (example && /^[A-Z]\d+$/.test(example) && serp) {
  exampleUrl = `https://openalex.org/${serp}/${example}`;
} else if (example && example.includes('/')) {
  exampleUrl = `https://openalex.org/${example}`;
}
---

{(example || count !== null || linksTo.length > 0) && (
  <p class:list={['entity-meta', { mobile }]}>
    {example && (
      <span class="group">
        <span class="label">Eg:</span>
        {exampleUrl ? <a href={exampleUrl}>{example}</a> : <span>{example}</span>}
      </span>
    )}
    {count !== null && (
      <span class="group">
        <span class="label">Count:</span>
        <a href={`https://openalex.org/${serp}`}>{count.toLocaleString('en-US')}</a>
      </span>
    )}
    {linksTo.length > 0 && (
      <span class="group links">
        <span class="label">Links:</span>
        <span>
          {linksTo.map((t, i) => (
            <>
              {i > 0 && ', '}
              <a href={`/data/${t}/`}>{t.replace(/-/g, ' ')}</a>
            </>
          ))}
        </span>
      </span>
    )}
  </p>
)}

<style>
  /* Card floated right of the intro; the first paragraph(s) wrap around it.
     House card style (Card.astro): panel bg, 1px hairline, radius 5, no shadow.
     Table alignment: label column auto-sizes to the widest label ("Links:"),
     values all start at the same x. Each .group contributes its label + value
     as grid items via display: contents. */
  .entity-meta {
    float: right;
    max-width: 19rem;
    margin: 0 0 1rem 1.75rem;
    padding: 0.65rem 1rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 5px;
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0 1ch;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.7;
  }
  .entity-meta.mobile {
    display: none;
    float: none;
    max-width: none;
    margin: 0 0 1.5rem;
  }
  @media (max-width: 700px) {
    .entity-meta {
      display: none;
    }
    .entity-meta.mobile {
      display: grid;
    }
  }
  .group {
    display: contents;
  }
  .label {
    color: var(--muted);
  }
  .entity-meta a {
    color: var(--ink);
  }
  .entity-meta a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
