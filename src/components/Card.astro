---
// Single-surface link card (Pass AB, 2026-08-08): white on white, hairline
// border, 12px radius, whisper shadow; hover darkens the border and lifts the
// shadow softly. Hierarchy is typographic (semibold title, muted blurb) — the
// old darker header strip + divider is gone (out of fashion per Linear/shadcn/
// Tailwind research; none of them shade card headers).
interface Props {
  title: string;
  href: string;
  // Opens elsewhere (new tab): show the app-bar-style ↗ in the top-right
  // corner and add target=_blank (oxjob #750 — the homepage Chat cards).
  external?: boolean;
}
const { title, href, external = false } = Astro.props;
---

<a class="card" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
  {external && <span class="ext" aria-hidden="true">↗</span>}
  <span class="card-head">
    <slot name="icon" />
    <span class="card-title">{title}</span>
  </span>
  <span class="card-body"><slot /></span>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    color: inherit;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.85rem 1rem 0.95rem;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .card:hover {
    border-color: var(--line-strong);
    box-shadow:
      0 2px 5px rgb(64 68 82 / 0.08),
      0 3px 9px rgb(64 68 82 / 0.08);
    text-decoration: none;
  }
  .card:hover .card-title {
    color: var(--accent);
  }
  .card-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.3rem;
  }
  .card-head :global(svg) {
    flex-shrink: 0;
    color: var(--muted);
  }
  .card-title {
    font-size: 0.92rem;
    font-weight: 600;
  }
  .card-body {
    flex: 1;
    color: var(--muted);
    font-size: 0.87rem;
    line-height: 1.5;
  }
  .ext {
    position: absolute;
    top: 0.7rem;
    right: 0.85rem;
    color: var(--faint);
    font-size: 0.85rem;
    line-height: 1;
  }
  .card:hover .ext {
    color: var(--muted);
  }
</style>
