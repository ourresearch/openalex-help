---
// ⌘K search modal. Backed by pagefind's JS API (`/pagefind/pagefind.js`) with
// our OWN results UI — the stock PagefindUI was dropped in oxjob #750 because
// it rendered nav chrome into every excerpt, highlighted single tokens all over
// the page, and stacked sub-results into an unreadable wall. This renders a
// Google-shaped list instead: eyebrow (the page's breadcrumb trail, carried in
// as pagefind meta) → bold page title → one snippet with the query highlighted.
//
// The pagefind assets exist only in the built site (`npm run build`); in
// `astro dev` the modal shows a gentle fallback note instead.
//
// `button` (default true) renders the visible navbar search pill. The homepage
// passes button={false} so there's only one search box on that page (its hero
// big-search box) — but the dialog + ⌘K / [data-search-trigger] wiring below
// still load, so the hero box keeps working (oxjob #354 Pass V).
interface Props {
  button?: boolean;
}
const { button = true } = Astro.props;
---

{button && (
  <button id="search-open" aria-label="Search" title="Search (⌘K)">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
      <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
    </svg>
    <span class="search-label">Search help center…</span>
    <kbd data-kbd-shortcut>⌘K</kbd>
  </button>
)}

{/* ⌘ is Mac-only vocabulary — swap the hint to "Ctrl K" off-Mac (oxjob #750
    Pass AL; Kyle caught the ⌘ on his PC). The keydown handler below already
    accepts both metaKey and ctrlKey; only the hints need to know. */}
<script>
  if (!/mac|iphone|ipad|ipod/i.test(navigator.platform || '')) {
    for (const k of document.querySelectorAll('[data-kbd-shortcut]')) k.textContent = 'Ctrl K';
    const open = document.getElementById('search-open');
    if (open) open.title = 'Search (Ctrl K)';
  }
</script>

<dialog id="search-dialog" aria-label="Search the help center">
  {/* Header stays put while the results list scrolls under it. */}
  <div class="sd-head">
    <svg class="sd-head-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
      <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
    </svg>
    <input
      id="sd-input"
      type="search"
      placeholder={'Search (eg: "rate limit")'}
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
      aria-controls="sd-body"
    />
    <button id="sd-clear" type="button" aria-label="Clear search" hidden>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  {/* Empty until you type — the placeholder carries the "keywords, not a
      question" hint on its own (Jason, oxjob #750: no suggestion chips, no
      explanatory copy). The dev-only note appears only if pagefind fails to
      load, which on the deployed site means never. */}
  <div class="sd-body" id="sd-body"></div>
  <p class="sd-fallback">Search runs on the deployed site — it’s unavailable in local dev.</p>
</dialog>

<style>
  #search-open {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font: inherit;
    font-size: 0.875rem;
    color: var(--muted);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    height: 36px; /* cursor-measured pill */
    padding: 0 0.75rem;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  #search-open:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }
  .search-label {
    flex: 1;
    text-align: left;
  }
  /* Wider pill once the header has room; below that it stays at natural width,
     and on phones it collapses to just the icon. The tab strip moved into the
     left nav drawer (oxjob #750 Pass AM), so the top bar is just logo + search
     — the pill can widen early. */
  @media (min-width: 720px) {
    #search-open {
      width: 300px; /* cursor-measured */
    }
  }
  @media (max-width: 640px) {
    .search-label,
    #search-open kbd {
      display: none;
    }
  }
  #search-open kbd {
    font-size: 0.7rem;
    color: var(--faint);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.05rem 0.3rem;
  }

  /* ---- dialog shell -------------------------------------------------------
     Height is capped against the VIEWPORT (it used to grow with the result
     list and run off the bottom of the screen — oxjob #750). The dialog is a
     flex column: fixed head, scrolling body. `display` only becomes flex when
     [open], or the browser can't hide a closed <dialog>. */
  #search-dialog {
    width: min(42rem, calc(100vw - 2rem));
    max-height: min(42rem, calc(100dvh - 12dvh - 2rem));
    margin: 6dvh auto auto;
    padding: 0;
    overflow: hidden;
    background: var(--bg);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.18);
  }
  #search-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  #search-dialog::backdrop {
    background: rgb(0 0 0 / 0.35);
    backdrop-filter: blur(2px);
  }

  .sd-head {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0 0.9rem;
    height: 3.25rem;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .sd-head-icon {
    flex: none;
    color: var(--faint);
  }
  #sd-input {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: none;
    border: none;
    outline: none;
    padding: 0;
  }
  #sd-input::placeholder {
    color: var(--faint);
  }
  /* Kill the browser's own search-field clear affordance — we render our own. */
  #sd-input::-webkit-search-cancel-button {
    display: none;
  }
  #sd-clear {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    color: var(--muted);
    background: none;
    border: none;
    border-radius: 6px;
    cursor: pointer;
  }
  /* `display: flex` above would otherwise beat the UA rule for [hidden]. */
  #sd-clear[hidden] {
    display: none;
  }
  #sd-clear:hover {
    color: var(--ink);
    background: var(--panel-strong);
  }

  .sd-body {
    flex: 1 1 auto;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.9rem 1.1rem 1.1rem;
  }
  /* Nothing typed yet: the dialog is just the search box, no empty well. */
  .sd-body:empty {
    padding: 0;
  }

  /* Dev-only note — shown only when pagefind failed to load, which on the
     deployed site means never. */
  .sd-fallback {
    display: none;
    flex: none;
    margin: 0;
    padding: 0.8rem 1.1rem;
    font-size: 0.8rem;
    color: var(--faint);
  }
  :global(#search-dialog.pf-failed) .sd-fallback {
    display: block;
  }
</style>

<style is:global>
  /* ---- results (Google-shaped: eyebrow → title → snippet) -----------------
     Global because the result list is built in client JS, so scoped-style
     hashes never reach it. */
  #search-dialog .sd-count {
    margin: 0 0 0.9rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  #search-dialog .sd-hit {
    display: block;
    padding: 0.55rem 0.6rem;
    margin: 0 -0.6rem;
    border-radius: 8px;
    color: inherit;
  }
  #search-dialog .sd-hit + .sd-hit {
    margin-top: 0.35rem;
  }
  #search-dialog .sd-hit:hover,
  #search-dialog .sd-hit.is-active {
    background: var(--panel);
    text-decoration: none;
  }
  #search-dialog .sd-eyebrow {
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--muted);
  }
  #search-dialog .sd-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
    margin-top: 0.05rem;
  }
  #search-dialog .sd-hit:hover .sd-title {
    text-decoration: underline;
  }
  #search-dialog .sd-snippet {
    margin: 0.15rem 0 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--muted);
  }
  /* Yellow highlighter on the matched phrase (Jason's call, oxjob #750) — a
     highlight, deliberately not a link color. */
  #search-dialog mark {
    background: #fef08a;
    color: var(--ink);
    border-radius: 2px;
    padding: 0 1px;
  }
  #search-dialog .sd-empty {
    margin: 0.4rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>

<script>
  const dialog = document.getElementById('search-dialog') as HTMLDialogElement;
  const input = document.getElementById('sd-input') as HTMLInputElement;
  const clearBtn = document.getElementById('sd-clear') as HTMLButtonElement;
  const body = document.getElementById('sd-body')!;

  const PAGE = 8; // results rendered per chunk; more load as you scroll

  type PagefindResult = { id: string; data: () => Promise<PagefindDoc> };
  type PagefindDoc = {
    url: string;
    excerpt: string;
    content: string;
    meta: Record<string, string>;
  };

  let pagefind: any = null;
  let loading: Promise<any> | null = null;
  let results: PagefindResult[] = [];
  let query = '';
  let shown = 0;
  let token = 0; // guards against out-of-order async renders
  let list: HTMLElement | null = null;
  let loadingMore = false;

  /** Load the pagefind ES module from the built site. The path is held in a
   *  variable so Vite leaves the import alone — /pagefind/* only exists after
   *  `pagefind --site dist`, never in the dev server. */
  function loadPagefind() {
    if (loading) return loading;
    const path = '/pagefind/pagefind.js';
    loading = import(/* @vite-ignore */ path)
      .then(async (mod) => {
        await mod.options({ excerptLength: 28 });
        mod.init();
        pagefind = mod;
        return mod;
      })
      .catch(() => {
        dialog.classList.add('pf-failed');
        return null;
      });
    return loading;
  }

  function openSearch() {
    if (!dialog.open) dialog.showModal();
    loadPagefind();
    input.focus();
    input.select();
  }

  const esc = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  /** Pagefind excerpts arrive as HTML with its own <mark>s in them; we throw
   *  those away and take the plain text. Pagefind marks every token it matched
   *  — searching "open access" highlights the "Open" inside "OpenAlex" — which
   *  reads as random highlighting (Jason, oxjob #750). We re-highlight below,
   *  on whole words only, preferring the whole phrase. */
  function plain(html: string) {
    const div = document.createElement('div');
    div.innerHTML = html;
    return (div.textContent ?? '').replace(/\s+/g, ' ').trim();
  }

  const reEsc = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

  /** Only a plural/inflection tail is allowed after a term ("citation" lights
   *  up "citations") — an open `\w*` would make "open" match "OpenAlex", which
   *  is exactly the scattershot highlighting we're replacing. */
  const TAIL = '(?:s|es|d|ed|ing)?\\b';

  /** Highlight whole-word matches. Built by slicing the raw text so escaping
   *  can never land inside an HTML entity. */
  function highlight(text: string, patterns: string[]) {
    if (patterns.length === 0) return esc(text);
    const re = new RegExp(`(${patterns.join('|')})`, 'gi');
    let out = '';
    let last = 0;
    let m: RegExpExecArray | null;
    while ((m = re.exec(text))) {
      if (m[0].length === 0) {
        re.lastIndex++;
        continue;
      }
      out += esc(text.slice(last, m.index)) + '<mark>' + esc(m[0]) + '</mark>';
      last = m.index + m[0].length;
    }
    return out + esc(text.slice(last));
  }

  /** A readable window of `content` around the match at `i`: opens at a
   *  sentence boundary when one is close behind, else at a word boundary. */
  function windowAt(content: string, i: number, len: number) {
    let start = Math.max(0, i - 120);
    const lead = content.slice(start, i);
    const sentence = /[.!?][")\]]?\s+(?=[A-Z0-9])/g;
    let m: RegExpExecArray | null;
    let boundary = -1;
    while ((m = sentence.exec(lead))) boundary = start + m.index + m[0].length;
    if (boundary >= 0) start = boundary;
    else if (start > 0) start = content.indexOf(' ', start) + 1 || start;

    let end = Math.min(content.length, i + len + 170);
    if (end < content.length) {
      const cut = content.lastIndexOf(' ', end);
      if (cut > i + len) end = cut;
    }
    const text = content.slice(start, end).trim();
    return (
      (start > 0 && boundary < 0 ? '…' : '') +
      text +
      (end < content.length && !/[.!?:]$/.test(text) ? '…' : '')
    );
  }

  // Code samples are indexed (people do search for `group_by` or an error
  // string) but they read as noise in a snippet, so a window heavy in code
  // punctuation loses to a prose one.
  const CODEY = /[{}[\]()<>=;|\\/"`$]/g;
  const codey = (s: string) => (s.match(CODEY)?.length ?? 0) / Math.max(1, s.length) > 0.045;

  function snippetHtml(doc: PagefindDoc, q: string) {
    const terms = q.split(/\s+/).filter(Boolean);
    const patterns = [
      ...(terms.length > 1 ? [`\\b${terms.map(reEsc).join('\\s+')}${TAIL}`] : []),
      ...terms.map((t) => `\\b${reEsc(t)}${TAIL}`),
    ];
    const phraseRe = terms.length > 1 ? new RegExp(patterns[0], 'i') : null;

    // Cut our own window rather than taking pagefind's: pagefind centres on the
    // densest match, which is often mid-code-sample, and it can't be asked for
    // the whole phrase. We score a handful of candidates instead — phrase beats
    // single term, prose beats code — and fall back to its excerpt if the match
    // was stemmed and we can't locate it ourselves.
    const content = (doc.content ?? '').replace(/\s+/g, ' ').trim();
    const finder = new RegExp(patterns.join('|'), 'gi');
    let best: { text: string; score: number } | null = null;
    let m: RegExpExecArray | null;
    let tried = 0;
    while ((m = finder.exec(content)) && tried < 8) {
      tried++;
      if (m[0].length === 0) {
        finder.lastIndex++;
        continue;
      }
      const text = windowAt(content, m.index, m[0].length);
      const score = (phraseRe?.test(text) ? 3 : 0) - (codey(text) ? 4 : 0);
      if (!best || score > best.score) best = { text, score };
      if (best.score >= 3) break;
    }
    return highlight(best ? best.text : plain(doc.excerpt), patterns);
  }

  function hitHtml(doc: PagefindDoc, q: string) {
    const eyebrow = doc.meta?.eyebrow ?? '';
    const title = doc.meta?.title ?? doc.url;
    return `<a class="sd-hit" href="${esc(doc.url)}">
      ${eyebrow ? `<div class="sd-eyebrow">${esc(eyebrow)}</div>` : ''}
      <div class="sd-title">${esc(title)}</div>
      <p class="sd-snippet">${snippetHtml(doc, q)}</p>
    </a>`;
  }

  async function renderMore(my: number) {
    if (!list || loadingMore || shown >= results.length) return;
    loadingMore = true;
    try {
      const slice = results.slice(shown, shown + PAGE);
      const docs = await Promise.all(slice.map((r) => r.data()));
      if (my !== token || !list) return;
      shown += slice.length;
      list.insertAdjacentHTML('beforeend', docs.map((d) => hitHtml(d, query)).join(''));
    } finally {
      loadingMore = false;
    }
    // The list may still be shorter than the scroll box — keep filling.
    if (my === token && body.scrollHeight <= body.clientHeight) renderMore(my);
  }

  /** More results load as you near the bottom. A scroll listener, not an
   *  IntersectionObserver: an IO whose root sits inside a top-layer <dialog>
   *  never fires in Chrome (verified, oxjob #750). */
  body.addEventListener('scroll', () => {
    if (body.scrollTop + body.clientHeight >= body.scrollHeight - 300) renderMore(token);
  });

  /** Nothing typed (or nothing to search with): collapse back to the bare box. */
  function clearBody() {
    list = null;
    body.replaceChildren();
    body.scrollTop = 0;
  }

  async function runSearch(q: string) {
    const my = ++token;
    clearBtn.hidden = q.length === 0;
    if (!q) return clearBody();

    const pf = await loadPagefind();
    if (my !== token) return;
    if (!pf) return clearBody(); // dev server: no /pagefind assets

    const search = await pf.debouncedSearch(q, {}, 200);
    if (search === null || my !== token) return; // superseded by a later keystroke

    results = search.results;
    query = q;
    shown = 0;
    list = null;

    if (results.length === 0) {
      body.replaceChildren();
      body.insertAdjacentHTML(
        'beforeend',
        `<p class="sd-empty">No results for <strong>${esc(q)}</strong>.</p>`
      );
      body.scrollTop = 0;
      return;
    }

    const count = results.length.toLocaleString();
    body.replaceChildren();
    body.insertAdjacentHTML(
      'beforeend',
      `<p class="sd-count">About ${count} result${results.length === 1 ? '' : 's'}</p>
       <div class="sd-list"></div>`
    );
    list = body.querySelector('.sd-list');
    body.scrollTop = 0;
    await renderMore(my);
  }

  /* ---- keyboard: ↑/↓ through hits, Enter opens the highlighted one -------- */
  function activeHit() {
    return body.querySelector<HTMLAnchorElement>('.sd-hit.is-active');
  }
  function moveActive(dir: 1 | -1) {
    const hits = Array.from(body.querySelectorAll<HTMLAnchorElement>('.sd-hit'));
    if (hits.length === 0) return;
    const cur = activeHit();
    const i = cur ? hits.indexOf(cur) : -1;
    const next = hits[Math.max(0, Math.min(hits.length - 1, i + dir))];
    cur?.classList.remove('is-active');
    next.classList.add('is-active');
    next.scrollIntoView({ block: 'nearest' });
  }

  input.addEventListener('input', () => runSearch(input.value.trim()));
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      moveActive(1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      moveActive(-1);
    } else if (e.key === 'Enter') {
      const hit = activeHit();
      if (hit) {
        e.preventDefault();
        location.href = hit.href;
      }
    }
  });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    clearBtn.hidden = true;
    input.focus();
    runSearch('');
  });

  document.getElementById('search-open')?.addEventListener('click', openSearch);
  // Any element with data-search-trigger (e.g. the landing page's big search
  // box) opens the same modal.
  for (const el of document.querySelectorAll('[data-search-trigger]')) {
    el.addEventListener('click', openSearch);
  }
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      dialog.open ? dialog.close() : openSearch();
    }
    if (e.key === '/' && !dialog.open && !(e.target instanceof HTMLInputElement)) {
      e.preventDefault();
      openSearch();
    }
  });
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
