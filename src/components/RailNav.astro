---
// PRIMARY navigation rail (oxjob #750 Pass AS): the M3 navigation-rail
// pattern — a PERMANENT left rail of big icons with labels underneath,
// identical on every page (the old expanded-drawer-on-Home / icon-rail-in-tab
// two-state dance is gone, along with its geometry-parity contract).
//
// Destinations: Home · Start · (divider) · How-to · Tutorials · (divider) ·
// Access · Data · API · … · App pinned at the bottom. The Chat surfaces left
// the rail entirely (Pass AS) — they live in the homepage Chat paragraph now.
//
// Selected tab: a blue pill highlights the ICON (accent wash + accent glyph,
// matching the secondary drawer's blue selected row). Hovering any item shows
// the popover tooltip (bold name + few-word description from nav-primary.ts).
import Icon from './Icon.astro';
import { PRIMARY_TABS, APP_LINK, isPrimaryActive } from '../lib/nav-primary';

const path = Astro.url.pathname;
const top = PRIMARY_TABS.filter((t) => t.group === 'top');
const learn = PRIMARY_TABS.filter((t) => t.group === 'learn');
const reference = PRIMARY_TABS.filter((t) => t.group === 'reference');
const active = (href: string) => (isPrimaryActive(href, path) ? 'page' : undefined);
---

<nav class="rail" aria-label="Primary">
  <div class="rail-scroll">
    {[top, learn, reference].map((group, i) => (
      <Fragment>
        {i > 0 && <div class="divider" aria-hidden="true"></div>}
        <div class="sect">
          {group.map((t) => (
            <a href={t.href} class="item" aria-current={active(t.href)} data-tip-title={t.label} data-tip-desc={t.tip}>
              <span class="pill"><Icon name={t.icon} size={20} /></span>
              <span class="label">{t.label}</span>
            </a>
          ))}
        </div>
      </Fragment>
    ))}
  </div>

  <div class="rail-foot">
    <a href={APP_LINK.href} class="item" data-tip-title={APP_LINK.label} data-tip-desc={APP_LINK.blurb}>
      <span class="pill"><Icon name={APP_LINK.icon} size={20} /></span>
      <span class="label">{APP_LINK.label}</span>
    </a>
  </div>

  {/* One shared tooltip, positioned beside the hovered item by the script.
      position:fixed so the .rail-scroll overflow can never clip it. */}
  <div class="rail-tip" role="tooltip" hidden>
    <strong class="rail-tip-title"></strong>
    <span class="rail-tip-desc"></span>
  </div>
</nav>

<script>
  // Item tooltips: destination name in bold over a few-word description
  // (`tip`/`blurb` in nav-primary.ts). Rows that open a new tab
  // (data-tip-ext) get the MDI open-in-new glyph beside the name.
  const EXT_ICON =
    '<svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z"/></svg>';
  const rail = document.querySelector<HTMLElement>('.rail');
  const tip = document.querySelector<HTMLElement>('.rail-tip');
  if (rail && tip) {
    const title = tip.querySelector('.rail-tip-title')!;
    const desc = tip.querySelector('.rail-tip-desc')!;
    let timer: number | undefined;
    const hide = () => {
      clearTimeout(timer);
      tip.hidden = true;
    };
    for (const row of rail.querySelectorAll<HTMLElement>('[data-tip-title]')) {
      const show = () => {
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          title.textContent = row.dataset.tipTitle ?? '';
          if ('tipExt' in row.dataset) title.insertAdjacentHTML('beforeend', EXT_ICON);
          desc.textContent = row.dataset.tipDesc ?? '';
          tip.hidden = false;
          const r = row.getBoundingClientRect();
          tip.style.left = `${r.right + 8}px`;
          const top = Math.min(
            Math.max(8, r.top + r.height / 2 - tip.offsetHeight / 2),
            window.innerHeight - tip.offsetHeight - 8
          );
          tip.style.top = `${top}px`;
        }, 100);
      };
      row.addEventListener('mouseenter', show);
      row.addEventListener('mouseleave', hide);
      row.addEventListener('focus', show);
      row.addEventListener('blur', hide);
      row.addEventListener('click', hide);
    }
  }
</script>

<style>
  /* The rail is the sticky left column, --rail-w wide on every page. */
  .rail {
    position: sticky;
    top: var(--nav-h);
    height: calc(100dvh - var(--nav-h));
    width: var(--rail-w);
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border-right: 1px solid var(--line);
    /* Above the (also-sticky) secondary Sidebar: sticky elements each make a
       stacking context, so without this the fixed-position tooltip — despite
       its own z-index — paints UNDER the sidebar (later in DOM order). */
    z-index: 5;
  }
  .rail-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1rem 0;
    scrollbar-width: thin;
  }
  .rail-foot {
    flex: none;
    padding: 0.6rem 0 0.85rem;
    border-top: 1px solid var(--line);
  }
  .sect {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .divider {
    flex: none;
    height: 1px;
    margin: 0 0.9rem;
    background: var(--line);
  }
  /* M3-style destination: icon in a pill, label underneath. */
  .item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.28rem;
    color: var(--ink);
    text-decoration: none;
  }
  .pill {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 1.9rem;
    border-radius: 999px;
    color: var(--muted);
    transition: background-color 0.12s;
  }
  .label {
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.01em;
  }
  .item:hover {
    text-decoration: none;
  }
  .item:hover .pill {
    background: var(--panel-strong);
    color: var(--accent);
  }
  .item:hover .label {
    color: var(--accent);
  }
  /* Selected tab: SOLID blue pill, white glyph (Jason — the wash read as
     half-opaque). Label below stays accent. */
  .item[aria-current='page'] .pill {
    background: var(--accent);
    color: #fff;
  }
  .item[aria-current='page'] .label {
    color: var(--accent);
    font-weight: 600;
  }

  /* ---- tooltip (shown/positioned by the script) -------------------------- */
  .rail-tip {
    position: fixed;
    z-index: 30;
    width: max-content;
    max-width: 17rem;
    padding: 0.55rem 0.75rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgb(15 18 25 / 0.12);
    pointer-events: none;
  }
  .rail-tip-title {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.84rem;
    font-weight: 650;
    color: var(--ink);
    margin-bottom: 0.15rem;
  }
  .rail-tip-title :global(svg) {
    flex: none;
    color: var(--faint);
  }
  .rail-tip-desc {
    display: block;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--muted);
    white-space: normal;
  }

  /* The rail is desktop chrome; on narrow screens the header hamburger menu
     takes over (see Base.astro), so the whole rail hides. */
  @media (max-width: 900px) {
    .rail {
      display: none;
    }
  }
</style>
