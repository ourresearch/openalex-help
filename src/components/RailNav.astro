---
// PRIMARY navigation drawer/rail (oxjob #750 Pass AM). Replaced the horizontal
// two-level tab strip with a two-LAYER left drawer (the M3 showcase / shadcn
// `collapsible="icon"` pattern):
//
//   • Home (`/`)        → this renders as a FULL drawer: Home · Quick Start ·
//                         Learn (How-to, Tutorials) · Reference (Access, Data,
//                         API) · Chat (external rows, each ↗) · App ↗ pinned
//                         at the bottom.
//   • inside a tab      → `<html class="in-tab">` collapses this to an ICON
//                         RAIL, and the tab's own sections render in the
//                         secondary Sidebar. Hovering / focusing the rail
//                         flyout-expands it back to the full drawer (as an
//                         overlay) so labels + Chat + App stay reachable.
//
// The state is URL-derived (set in Base.astro), not client JS: switching tabs
// is just navigation, so "collapse + open the secondary drawer" falls out of
// the next page rendering in the in-tab state. All content comes from the one
// shared source `lib/nav-primary.ts`.
import Icon from './Icon.astro';
import {
  PRIMARY_TABS,
  ROLE_LABELS,
  CHAT_ROWS,
  ASK_AI_PROVIDERS,
  APP_LINK,
  isPrimaryActive,
} from '../lib/nav-primary';

const path = Astro.url.pathname;
const top = PRIMARY_TABS.filter((t) => t.group === 'top');
const learn = PRIMARY_TABS.filter((t) => t.group === 'learn');
const reference = PRIMARY_TABS.filter((t) => t.group === 'reference');
const active = (href: string) => (isPrimaryActive(href, path) ? 'page' : undefined);
---

<nav class="rail" aria-label="Primary">
  <div class="rail-scroll">
    <div class="sect">
      {top.map((t) => (
        <a href={t.href} class="row" aria-current={active(t.href)} title={t.label}>
          <Icon name={t.icon} size={18} />
          <span class="label">{t.label}</span>
        </a>
      ))}
    </div>

    <div class="sect">
      <span class="sect-head">{ROLE_LABELS.learn}</span>
      {learn.map((t) => (
        <a href={t.href} class="row" aria-current={active(t.href)} title={t.label}>
          <Icon name={t.icon} size={18} />
          <span class="label">{t.label}</span>
        </a>
      ))}
    </div>

    <div class="sect">
      <span class="sect-head">{ROLE_LABELS.reference}</span>
      {reference.map((t) => (
        <a href={t.href} class="row" aria-current={active(t.href)} title={t.label}>
          <Icon name={t.icon} size={18} />
          <span class="label">{t.label}</span>
        </a>
      ))}
    </div>

    <div class="sect">
      <span class="sect-head">Chat</span>
      {/* Ask AI = a menu of assistant deep-links (prefilled with our docs).
          The <details> only opens once the rail is expanded (drawer on Home,
          or hover-flyout in a tab) — its menu is hidden while collapsed. */}
      <details class="ask-ai">
        <summary class="row" title="Ask AI">
          <Icon name="creation" size={18} />
          <span class="label">Ask AI</span>
          <span class="ext" aria-hidden="true">↗</span>
        </summary>
        <div class="providers">
          {ASK_AI_PROVIDERS.map((p) => (
            <a href={p.href} target="_blank" rel="noopener">{p.label} ↗</a>
          ))}
        </div>
      </details>
      {CHAT_ROWS.map((r) => (
        <a href={r.href} class="row" target="_blank" rel="noopener" title={r.title}>
          <Icon name={r.icon} size={18} />
          <span class="label">{r.title}</span>
          <span class="ext" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>

  <div class="rail-foot">
    <a href={APP_LINK.href} class="row" title={APP_LINK.label}>
      <Icon name={APP_LINK.icon} size={18} />
      <span class="label">{APP_LINK.label}</span>
    </a>
  </div>
</nav>

<script>
  // Close the Ask AI menu on an outside click, and whenever the rail collapses
  // (pointer leaves an in-tab rail) so it never reopens half-hidden.
  const askAi = document.querySelector<HTMLDetailsElement>('.rail .ask-ai');
  const rail = document.querySelector<HTMLElement>('.rail');
  if (askAi) {
    document.addEventListener('click', (e) => {
      if (askAi.open && !askAi.contains(e.target as Node)) askAi.open = false;
    });
    rail?.addEventListener('mouseleave', () => {
      askAi.open = false;
    });
  }
</script>

<style>
  /* The rail is the sticky left column. Its width is --primary-w (set in
     global.css: the full --drawer-w on Home, the narrow --rail-w in a tab).
     In a tab, hover/focus expands it back to --drawer-w as a floating overlay
     — collapsed styling lives under `html.in-tab .rail:not(:hover):...`. */
  .rail {
    position: sticky;
    top: var(--nav-h);
    height: calc(100dvh - var(--nav-h));
    width: var(--primary-w);
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border-right: 1px solid var(--line);
    z-index: 5; /* flyout overlays content + the secondary sidebar; below header (10) */
    transition: width 0.16s ease, box-shadow 0.16s ease;
  }
  .rail-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    padding: 1.15rem 0 1rem;
    scrollbar-width: thin;
  }
  .rail-foot {
    flex: none;
    padding: 0.5rem 0 0.75rem;
    border-top: 1px solid var(--line);
  }
  .sect {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .sect-head {
    padding: 0 1.15rem;
    margin-bottom: 0.35rem;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--faint);
    white-space: nowrap;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    height: 2.2rem;
    margin: 0 0.5rem;
    padding: 0 0.65rem;
    border-radius: 7px;
    color: var(--ink);
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
  }
  .row :global(svg) {
    flex: none;
    color: var(--muted);
  }
  .row:hover {
    background: var(--panel-strong);
    color: var(--accent);
    text-decoration: none;
  }
  .row:hover :global(svg) {
    color: var(--accent);
  }
  .row[aria-current='page'] {
    background: var(--accent-wash);
    color: var(--accent);
    font-weight: 550;
  }
  .row[aria-current='page'] :global(svg) {
    color: var(--accent);
  }
  .label {
    display: block;
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ext {
    flex: none;
    color: var(--faint);
    font-size: 0.8rem;
    line-height: 1;
  }
  .row:hover .ext {
    color: var(--accent);
  }

  /* Ask AI menu (mirrors the old homepage Chat box). */
  .ask-ai summary {
    list-style: none;
    cursor: pointer;
  }
  .ask-ai summary::-webkit-details-marker {
    display: none;
  }
  .providers {
    display: flex;
    flex-direction: column;
    margin: 0.1rem 0.9rem 0.2rem;
    padding: 0.25rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .providers a {
    padding: 0.35rem 0.6rem;
    border-radius: 6px;
    color: var(--ink);
    font-size: 0.86rem;
  }
  .providers a:hover {
    background: var(--bg);
    color: var(--accent);
    text-decoration: none;
  }

  /* ---- collapsed icon rail (in a tab, not hovered) ---------------------- */
  html.in-tab .rail:not(:hover):not(:focus-within) .label,
  html.in-tab .rail:not(:hover):not(:focus-within) .ext,
  html.in-tab .rail:not(:hover):not(:focus-within) .sect-head {
    display: none;
  }
  html.in-tab .rail:not(:hover):not(:focus-within) .row {
    justify-content: center;
    padding: 0;
    margin: 0 0.5rem;
  }
  html.in-tab .rail:not(:hover):not(:focus-within) .providers {
    display: none;
  }
  /* Collapsed: sect-heads are hidden, so lean on the gap between .sect blocks
     for grouping; add a hairline above Reference/Chat for a little structure. */
  html.in-tab .rail:not(:hover):not(:focus-within) .rail-scroll {
    gap: 0.5rem;
  }

  /* ---- hover / focus flyout (expand back to the full drawer) ------------ */
  html.in-tab .rail:hover,
  html.in-tab .rail:focus-within {
    width: var(--drawer-w);
    box-shadow: 6px 0 24px rgb(15 18 25 / 0.08);
  }

  /* The rail is desktop chrome; on narrow screens the header hamburger menu
     takes over (see Base.astro), so the whole rail hides. */
  @media (max-width: 900px) {
    .rail {
      display: none;
    }
  }
</style>
