---
// Article-header breadcrumb trail (oxjob #354 Pass S): replaces the old
// plain-text eyebrow. Tab → group → (subgroup); the article's own title is the
// H1 below, never a crumb. Deliberate divergence from Cursor (which has no
// breadcrumbs) — child pages carry context-free names ("Basic", "Overview"),
// so the trail supplies the context and gives one-click up-navigation.
// The first crumb carries the tab's rail icon (oxjob #750 Pass AN) so the
// trail opens with the same glyph the icon rail shows for this section.
import Icon from './Icon.astro';
import type { Crumb } from '../lib/nav';

interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

{/* data-pagefind-ignore: the trail is navigation chrome, not page content — it
    reaches search as the `eyebrow` meta instead (oxjob #750), so indexing it
    here would only pad every excerpt with "Access Fixing errors". */}
<nav class="breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore>
  <ol>
    {crumbs.map((c, i) => (
      <li>
        {i > 0 && (
          <svg class="sep" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
        )}
        {c.href ? (
          <a href={c.href}>
            {c.icon && <Icon name={c.icon} size={13} />}
            {c.label}
          </a>
        ) : (
          <span>
            {c.icon && <Icon name={c.icon} size={13} />}
            {c.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs {
    margin-bottom: 0.6rem;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    font-size: 0.82rem;
    color: var(--muted);
  }
  li {
    display: flex;
    align-items: center;
  }
  .sep {
    flex: none;
    margin: 0 0.35rem;
    color: var(--faint);
  }
  a {
    color: var(--muted);
  }
  a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  /* First-crumb tab icon: inline with the label, optically centered. */
  a, span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
</style>
