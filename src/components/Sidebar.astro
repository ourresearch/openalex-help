---
// Cursor-style left sidebar: pinned to the viewport edge, full height below
// the header, its own scroll, hairline border-right. Shared by the docs/api
// tab landings and article pages.
import type { ResolvedGroup } from '../lib/nav';
import { urlFor, type Tab } from '../lib/tabs';

interface Props {
  tab: Tab;
  groups: ResolvedGroup[];
  activeSlug?: string;
}
const { tab, groups, activeSlug } = Astro.props;
---

<aside>
  <nav aria-label="Section pages">
    {groups.map((g) => (
      <div class="group">
        <span class="group-label">{g.label}</span>
        {g.entries.map((e) => (
          <a href={urlFor(tab, e)} aria-current={e.id === activeSlug ? 'page' : undefined}>
            {e.data.title}
          </a>
        ))}
      </div>
    ))}
  </nav>
</aside>

<style>
  aside {
    border-right: 1px solid var(--line);
  }
  nav {
    position: sticky;
    top: var(--nav-h);
    height: calc(100dvh - var(--nav-h));
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.5rem 1rem 2.5rem 1.5rem;
    font-size: 0.86rem;
    scrollbar-width: thin;
  }
  .group {
    display: flex;
    flex-direction: column;
  }
  .group-label {
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 0.45rem;
  }
  a {
    color: var(--ink);
    padding: 0.22rem 0.5rem;
    margin-left: -0.5rem;
    border-radius: 6px;
    line-height: 1.35;
  }
  a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  a[aria-current='page'] {
    color: var(--accent);
    font-weight: 550;
  }
  @media (max-width: 900px) {
    aside {
      display: none;
    }
  }
</style>
