---
// Cursor-style left sidebar: pinned to the viewport edge, full height below
// the header, its own scroll, hairline border-right. Shared by the docs/api
// tab landings and article pages.
//
// Three levels (oxjob #354 Pass 0): group label → item → chevron-expandable
// subitems. A subgroup renders as a native <details> row; it auto-opens when
// the active page is inside it. A subgroup's optional overview page renders as
// its first child link.
import type { ResolvedGroup } from '../lib/nav';
import { urlFor, type Tab } from '../lib/tabs';

interface Props {
  tab: Tab;
  groups: ResolvedGroup[];
  activeSlug?: string;
}
const { tab, groups, activeSlug } = Astro.props;
const path = Astro.url.pathname;
---

<aside>
  <nav aria-label="Section pages" data-tab={tab}>
    {groups.map((g) => (
      <div class="group">
        <span class="group-label">{g.label}</span>
        {g.items.map((item) =>
          item.children.length ? (
            <details
              open={
                item.entry?.id === activeSlug ||
                item.children.some((c) => c.id === activeSlug) ||
                undefined
              }
            >
              <summary>
                <span>{item.label}</span>
                <svg class="chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
              </summary>
              <div class="children">
                {item.entry && (
                  <a href={urlFor(tab, item.entry)} aria-current={item.entry.id === activeSlug ? 'page' : undefined}>
                    {item.entry.data.title}
                  </a>
                )}
                {item.children.map((e) => (
                  <a href={urlFor(tab, e)} aria-current={e.id === activeSlug ? 'page' : undefined}>
                    {e.data.title}
                  </a>
                ))}
              </div>
            </details>
          ) : item.href ? (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          ) : (
            item.entry && (
              <a href={urlFor(tab, item.entry)} aria-current={item.entry.id === activeSlug ? 'page' : undefined}>
                {item.entry.data.title}
              </a>
            )
          )
        )}
      </div>
    ))}
  </nav>
</aside>

<!-- Sidebar scroll persistence (Cursor parity, oxjob #354): each full page load
     resets the nav's scroll, so save it to sessionStorage (per tab, like
     Cursor's docs-scroll-<section> keys) and restore on the next load. Must be
     is:inline and sit right after the <nav> markup: it then runs during HTML
     parse, after the blocking stylesheets but before first paint, so the
     restore never flickers. -->
<script is:inline>
  (() => {
    const nav = document.querySelector('aside > nav[data-tab]');
    if (!nav) return;
    const key = 'sidebar-scroll-' + nav.dataset.tab;
    let saved = null;
    try {
      saved = sessionStorage.getItem(key);
    } catch {}
    if (saved !== null) {
      nav.scrollTop = parseInt(saved, 10) || 0;
    } else {
      // First entry in this tab (deep link, new tab): show the reader where
      // they are instead of the top of the drawer.
      const active = nav.querySelector('a[aria-current="page"]');
      if (active) active.scrollIntoView({ block: 'nearest' });
    }
    nav.addEventListener(
      'scroll',
      () => {
        try {
          sessionStorage.setItem(key, String(nav.scrollTop));
        } catch {}
      },
      { passive: true }
    );
  })();
</script>

<style>
  aside {
    border-right: 1px solid var(--line);
  }
  nav {
    position: sticky;
    top: var(--nav-h);
    height: calc(100dvh - var(--nav-h));
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.5rem 1rem 2.5rem 1.5rem;
    /* Cursor overrides Tailwind's text-base with --font-size-base: 15px /
       140% line-height / .005em tracking — measured on the inner span, not
       the 16px-inheriting <a> wrapper (round-4 measured the wrapper). */
    font-size: 15px;
    letter-spacing: 0.005em;
    scrollbar-width: thin;
  }
  /* Sections are NOT collapsible (Jason, Pass S round 2 — Cursor parity):
     only SUBGROUPS collapse, and those start closed unless they hold the
     active page. */
  .group {
    display: flex;
    flex-direction: column;
  }
  /* Pass AL (oxjob #750): headers bolder + ink so the hierarchy reads
     header > pages (Kyle: it read INVERTED — "I had no idea sections were a
     thing"). Smallest change first (weight/color/size); collapsible accordions
     are the fallback if this fails Jason's red pen. */
  .group-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.45rem;
  }
  a {
    color: var(--ink);
    padding: 0.22rem 0.5rem;
    margin-left: -0.5rem;
    border-radius: 6px;
    line-height: 1.4; /* 21px at 15px, cursor-measured */
  }
  a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  a[aria-current='page'] {
    color: var(--accent);
    font-weight: 550;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--ink);
    padding: 0.22rem 0.5rem;
    margin-left: -0.5rem;
    border-radius: 6px;
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--accent);
  }
  .chev {
    flex: none;
    color: var(--faint);
    transition: transform 0.15s;
  }
  details[open] > summary .chev {
    transform: rotate(90deg);
  }
  .children {
    display: flex;
    flex-direction: column;
    margin-left: 0.55rem;
    padding-left: 0.55rem;
    border-left: 1px solid var(--line);
  }
  @media (max-width: 900px) {
    aside {
      display: none;
    }
  }
</style>
